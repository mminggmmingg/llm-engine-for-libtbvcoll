+// engine2n: one-token SSM_CONV -> SILU [-> views] -> the q/k norm pair above, when the pair's rows are whole 128-channel blocks of
+// the conv output: one kernel (ssm-conv.cu ssm_conv_silu_norm_pair_f32, same values). GGML_CUDA_NO_CONV_NORM_PAIR=1 turns it off;
+// GGML_CUDA_CONV_NORM_VERIFY=1 (debug) also runs the two ordinary kernels and compares bit for bit.
+static int ggml_cuda_try_ssm_conv_norm_pair(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool off = getenv("GGML_CUDA_NO_CONV_NORM_PAIR") != nullptr;
+    if (off || !ggml_cuda_can_fuse(cgraph, i, { GGML_OP_SSM_CONV, GGML_OP_UNARY }, { GGML_UNARY_OP_SILU })) {
+        return 0;
+    }
+    ggml_tensor * conv = cgraph->nodes[i];
+    ggml_tensor * silu = cgraph->nodes[i + 1];
+    int r = i + 2;
+    while (r < cgraph->n_nodes && ggml_cuda_is_view_or_noop(cgraph->nodes[r])) {
+        r++;
+    }
+    if (r >= cgraph->n_nodes || r - i > 4) {
+        return 0;
+    }
+    const int n = ggml_cuda_rms_norm_scale_pair_match(cgraph, r);
+    if (n == 0) {
+        return 0;
+    }
+    ggml_tensor * rms_a = cgraph->nodes[r];
+    ggml_tensor * sc_a  = cgraph->nodes[r + 1];
+    ggml_tensor * sc_b  = cgraph->nodes[r + n];
+    const ggml_tensor * xa = rms_a->src[0];
+    const ggml_tensor * src0 = conv->src[0];
+    const ggml_tensor * src1 = conv->src[1];
+    const int64_t off_a = (const char *) xa->data - (const char *) silu->data;
+    if (src1->ne[0] != 4 || src0->type != GGML_TYPE_F32 || src0->nb[0] != sizeof(float) || src0->nb[1] != src0->ne[0]*sizeof(float) ||
+            src1->nb[0] != sizeof(float) || silu->type != GGML_TYPE_F32 || silu->ne[1] != 1 || silu->ne[2] != 1 ||
+            silu->ne[0] % 128 != 0 || src0->ne[1] != silu->ne[0] || xa->op != GGML_OP_VIEW || xa->src[0] != silu ||
+            xa->ne[0] != 128 || xa->nb[1] != 128*sizeof(float) || xa->ne[2] != 1 || off_a < 0 || off_a % (128*sizeof(float)) != 0 ||
+            ggml_cuda_tensors_overlap(sc_a, silu) || ggml_cuda_tensors_overlap(sc_b, silu) ||
+            ggml_cuda_tensors_overlap(sc_a, src0) || ggml_cuda_tensors_overlap(sc_b, src0)) {
+        return 0;  // (the norm outputs may be allocated over the conv input, which other blocks are still reading)
+    }
+    float eps, scale_out;
+    memcpy(&eps, rms_a->op_params, sizeof(float));
+    memcpy(&scale_out, sc_a->op_params, sizeof(float));
+    const int nrows_a = (int) xa->ne[1];
+    const int nrows_b = (int) cgraph->nodes[r + n - 1]->src[0]->ne[1];
+    if ((off_a / (int64_t) (128*sizeof(float))) + nrows_a + nrows_b > silu->ne[0] / 128) {
+        return 0;
+    }
+    ggml_cuda_op_ssm_conv_silu_norm_pair(ctx, conv, silu, (int) (off_a / (int64_t) (128*sizeof(float))), nrows_a, nrows_b, sc_a, sc_b,
+        eps, scale_out);
+
+    static const bool verify = getenv("GGML_CUDA_CONV_NORM_VERIFY") != nullptr;
+    if (verify) {
+        const ggml_tensor * outs[3] = { silu, sc_a, sc_b };
+        std::vector<char> a[3], b[3];
+        for (int k = 0; k < 3; k++) {
+            a[k].resize(ggml_nbytes(outs[k]));
+            b[k].resize(ggml_nbytes(outs[k]));
+            CUDA_CHECK(cudaMemcpyAsync(a[k].data(), outs[k]->data, a[k].size(), cudaMemcpyDeviceToHost, ctx.stream()));
+        }
+        ggml_cuda_op_ssm_conv(ctx, conv, nullptr, silu);
+        ggml_cuda_op_rms_norm_scale_pair(ctx, rms_a, sc_a, cgraph->nodes[r + n - 1], sc_b);
+        for (int k = 0; k < 3; k++) {
+            CUDA_CHECK(cudaMemcpyAsync(b[k].data(), outs[k]->data, b[k].size(), cudaMemcpyDeviceToHost, ctx.stream()));
+        }
+        CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+        const bool same = a[0] == b[0] && a[1] == b[1] && a[2] == b[2];
