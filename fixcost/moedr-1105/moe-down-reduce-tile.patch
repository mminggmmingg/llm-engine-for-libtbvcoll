+static void mul_mat_vec_q_moe_down_reduce_switch_type(
+        const void * vx, const ggml_type type_x, const void * vy, const int32_t * ids, float * down, const float * expert_scale,
+        const float * weights, float * dst, const int ncols_x, const int nrows_x, const int nchannels_y, const int stride_row_x,
+        const int stride_channel_x, const int stride_channel_y, const int stride_channel_dst, const int n_expert_used, unsigned * counters,
+        cudaStream_t stream) {
+    const dim3 grid(nrows_x / 32, n_expert_used, 1);
+#define MOE_DR_CASE(t) case t: mul_mat_vec_q_moe_down_reduce<t><<<grid, 1024, 0, stream>>>(vx, vy, ids, down, expert_scale, weights, dst, \
+        ncols_x, nchannels_y, stride_row_x, stride_channel_x, stride_channel_y, stride_channel_dst, n_expert_used, counters); break;
+    switch (type_x) {
+        MOE_DR_CASE(GGML_TYPE_Q4_0)
+        MOE_DR_CASE(GGML_TYPE_Q5_0)
+        MOE_DR_CASE(GGML_TYPE_Q8_0)
+        MOE_DR_CASE(GGML_TYPE_IQ4_NL)
+        MOE_DR_CASE(GGML_TYPE_IQ4_XS)
+        MOE_DR_CASE(GGML_TYPE_Q4_K)
+        MOE_DR_CASE(GGML_TYPE_Q5_K)
+        MOE_DR_CASE(GGML_TYPE_Q6_K)
+        default:
+            GGML_ABORT("moe down reduce: unsupported type");
+    }
+#undef MOE_DR_CASE
+}
