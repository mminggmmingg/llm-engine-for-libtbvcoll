+// engine2n: one-token MoE down projection (MUL_MAT_ID) and the weighted sum over the used experts in one kernel: a block of 32 warps
+// owns 32 consecutive rows of one expert slot (one warp per row with the loop and warp sum mul_mat_vec_q uses on RDNA) and stores
+// them as the down projection would; the last of the slots' blocks for those rows (a counter per row tile) sums them in
+// moe_weighted_reduction_f32's order. Same values; the reduction kernel goes away, and each block still streams one expert's rows.
+template <ggml_type type>
+static __global__ void __launch_bounds__(1024, 1) mul_mat_vec_q_moe_down_reduce(
+        const void * vx, const void * vy, const int32_t * ids, float * down, const float * expert_scale, const float * weights,
+        float * dst, const uint32_t ncols_x, const uint32_t nchannels_y, const uint32_t stride_row_x, const uint32_t stride_channel_x,
+        const uint32_t stride_channel_y, const uint32_t stride_channel_dst, const int n_expert_used, unsigned * counters) {
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr int warp_size = 32;
+    constexpr int blocks_per_iter = vdr * warp_size / qi;
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+
+    const int lane = threadIdx.x % warp_size;
+    const int warp = threadIdx.x / warp_size;
+    const uint32_t channel_dst = blockIdx.y;
+    const uint32_t channel_x   = ids[channel_dst];
+    const uint32_t channel_y   = channel_dst % nchannels_y;
+    const int row0 = blockIdx.x*warp_size + warp;
+    const int blocks_per_row_x = ncols_x / qk;
+
+    float tmp = 0.0f;
+    const block_q8_1 * y = ((const block_q8_1 *) vy) + channel_y*stride_channel_y;
+    const int kbx_offset = channel_x*stride_channel_x + row0*stride_row_x;
+    for (int kbx = lane / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const int kqs = vdr * (lane % (qi/vdr));
+        tmp += vec_dot_q_cuda(vx, &y[kby], kbx_offset + kbx, kqs);
+    }
+    tmp = warp_reduce_sum<warp_size>(tmp);
+    if (lane == 0) {
+        down[channel_dst*stride_channel_dst + row0] = tmp;
+    }
+
+    __shared__ unsigned last;
+    __threadfence();
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        last = atomicAdd(&counters[blockIdx.x], 1u) == (unsigned) n_expert_used - 1;
+        if (last) {
+            atomicExch(&counters[blockIdx.x], 0u);
+        }
+    }
+    __syncthreads();
+    if (last && threadIdx.x < warp_size) {
+        __threadfence();
+        const int row = blockIdx.x*warp_size + threadIdx.x;
+        const float first_scale = expert_scale != nullptr ? expert_scale[0] : 1.0f;
+        float       sum         = (down[row] * first_scale) * weights[0];
+        for (int expert = 1; expert < n_expert_used; ++expert) {
+            const float scale = expert_scale != nullptr ? expert_scale[expert] : 1.0f;
+            sum += (down[expert*stride_channel_dst + row] * scale) * weights[expert];
+        }
+        dst[row] = sum;
+    }
+}
