+// engine2n: one-token GDN beta/alpha matmul followed by the gates (k_gdn_gates): one warp per row as mul_mat_vec_q on RDNA (same
+// grid, one warp per block), and lane 0 turns its row into the gate or beta value with k_gdn_gates' arithmetic. Same values; the
+// gates kernel goes away. The matmul result itself is not stored (only the gates read it).
+template <ggml_type type>
+static __global__ void __launch_bounds__(32, 1) mul_mat_vec_q_gdn_gates(
+        const void * vx, const void * vy, const uint32_t ncols_x, const uint32_t stride_row_x, const float * bias, const float * A,
+        float * gate, float * beta_out, const int nh, const int a_off, const int b_off, const int b_stride, const int beta_stride) {
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr int warp_size = 32;
+    constexpr int blocks_per_iter = vdr * warp_size / qi;
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+
+    const int lane = threadIdx.x;
+    const int row0 = blockIdx.x;
+    const int blocks_per_row_x = ncols_x / qk;
+    float tmp = 0.0f;
+    const block_q8_1 * y = (const block_q8_1 *) vy;
+    const int kbx_offset = row0*stride_row_x;
+    for (int kbx = lane / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const int kqs = vdr * (lane % (qi/vdr));
+        tmp += vec_dot_q_cuda(vx, &y[kby], kbx_offset + kbx, kqs);
+    }
+    tmp = warp_reduce_sum<warp_size>(tmp);
+    if (lane == 0) {
+#pragma clang fp contract(off)
+        const int ja = row0 - a_off;
+        if (ja >= 0 && ja < nh) {
+            const float x = tmp + bias[ja];
+            gate[ja] = ggml_cuda_op_softplus_single(x) * A[ja];
+        }
+        const int jb = row0 - b_off;
+        if (jb >= 0 && jb % b_stride == 0 && jb / b_stride < nh) {
+            beta_out[(jb / b_stride)*beta_stride] = ggml_cuda_op_sigmoid_single(tmp);
+        }
+    }
+}
+
+static void mul_mat_vec_q_gdn_gates_switch_type(
+        const void * vx, const ggml_type type_x, const void * vy, const int ncols_x, const int nrows_x, const int stride_row_x,
+        const ggml_cuda_mm_fusion_args_host & f, cudaStream_t stream) {
+#define GDN_GATES_CASE(t) case t: mul_mat_vec_q_gdn_gates<t><<<nrows_x, 32, 0, stream>>>(vx, vy, ncols_x, stride_row_x, f.gdn_bias, \
+        f.gdn_A, f.gdn_gate, f.gdn_beta, f.gdn_nh, f.gdn_a_off, f.gdn_b_off, f.gdn_b_stride, f.gdn_beta_stride); break;
+    switch (type_x) {
+        GDN_GATES_CASE(GGML_TYPE_Q4_0)
+        GDN_GATES_CASE(GGML_TYPE_Q5_0)
+        GDN_GATES_CASE(GGML_TYPE_Q8_0)
+        GDN_GATES_CASE(GGML_TYPE_IQ4_NL)
+        GDN_GATES_CASE(GGML_TYPE_IQ4_XS)
+        GDN_GATES_CASE(GGML_TYPE_Q4_K)
+        GDN_GATES_CASE(GGML_TYPE_Q5_K)
+        GDN_GATES_CASE(GGML_TYPE_Q6_K)
+        default:
+            GGML_ABORT("gdn gates: unsupported type");
+    }
+#undef GDN_GATES_CASE
+}
