+// [3] the peer's flag seen, [4] add end. Same kernels, no extra launches. The RPC server's timeline (GGML_RPC_COMM_PROF_TL)
+// reads them with ggml_backend_comm_ts_get and puts them on the host clock with ggml_backend_comm_ts_calib pairs.
+#define GGML_CUDA_COMM_TS_N 8192
+static uint64_t * ggml_cuda_comm_ts() {
+    static uint64_t * ts = getenv("GGML_CUDA_COMM_TS") != nullptr ?
+        (uint64_t *) ggml_backend_cuda_comm_host_alloc(GGML_CUDA_COMM_TS_N*8*sizeof(uint64_t)) : nullptr;
+    return ts;
+}
