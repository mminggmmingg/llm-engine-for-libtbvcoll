+template <bool has_ff>
+static __global__ void __launch_bounds__(32) idx_k_pool_f32(const idx_k_pool_args a, const int n_dims, const int n_offs,
+        const int32_t * pos, const float freq_scale, const float ext_factor, const float attn_factor, const rope_corr_dims corr_dims,
+        const float theta_scale, const float * freq_factors, const mrope_sections sections, const bool is_imrope) {
+    constexpr int D = 128;
+    __shared__ __align__(16) float ys[D];
+    __shared__ __align__(16) float yo[D];
+    const int l = threadIdx.x;
+
+    // SET_ROWS of the concat row [k | fill]
+    half * row = (half *) (a.cache + a.row_new[0]*a.cache_nb1);
+    for (int j = 0; j < 4; j++) {
+        row[4*l + j]     = ggml_cuda_cast<half>(a.k[4*l + j]);
+        row[D + 4*l + j] = ggml_cuda_cast<half>(a.fill);
+    }
+    // GET_ROWS -> CONT -> ADDs -> SCALE
+    float xs4[4];
+    for (int j = 0; j < 4; j++) {
+        const int e = 4*l + j;
+        float acc = ggml_cuda_cast<float>(((const half *) (a.cache + (int64_t) a.pool_ids[0]*a.cache_nb1))[e]);
+        for (int p = 1; p < a.npool; p++) {
+            acc = acc + ggml_cuda_cast<float>(((const half *) (a.cache + (int64_t) a.pool_ids[p]*a.cache_nb1))[e]);
+        }
+        xs4[j] = a.sc * acc + a.sb;
+    }
+    // RMS_NORM -> MUL as rms_norm_f32<32, 1, vec, multiply>
+    float4 xs[1];
+    xs[0] = make_float4(xs4[0], xs4[1], xs4[2], xs4[3]);
+    float tmp = 0.0f;
+    tmp += xs[0].x*xs[0].x + xs[0].y*xs[0].y + xs[0].z*xs[0].z + xs[0].w*xs[0].w;
+    tmp = block_reduce<block_reduce_method::SUM, 32>(tmp, (float *) nullptr);
+    const float scale = rsqrtf(tmp / D + a.eps);
+    float4 r = make_float4(scale*xs[0].x, scale*xs[0].y, scale*xs[0].z, scale*xs[0].w);
+    const float4 m = ((const float4 *) a.w)[l];
+    r.x *= m.x;
+    r.y *= m.y;
+    r.z *= m.z;
+    r.w *= m.w;
+    ((float4 *) ys)[l] = r;
+    __syncthreads();
+    // ROPE (one row, one token)
+    for (int i0 = 2*l; i0 < D; i0 += 64) {
+        rope_multi_pair<true, has_ff, float>((const float *) ys, yo, i0, i0 / 2, i0 / 2, 0u, 1, n_dims, n_offs, pos, freq_scale,
+            ext_factor, attn_factor, corr_dims, theta_scale, freq_factors, sections, is_imrope, false);
+    }
+    __syncthreads();
+    // the rope result and its SET_ROWS into the pooled half
+    half * prow = (half *) (a.cache + a.row_pool[0]*a.cache_nb1) + D;
+    for (int j = 0; j < 4; j++) {
+        const int e = 4*l + j;
+        a.rope_out[e] = yo[e];
+        prow[e] = ggml_cuda_cast<half>(yo[e]);
+    }
