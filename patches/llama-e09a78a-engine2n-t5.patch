+    const bool greedy = (params.samplers.back() == COMMON_SAMPLER_TYPE_TEMPERATURE && params.temp == 0.0f && params.dynatemp_range == 0.0f) ||
+                        (params.samplers.back() == COMMON_SAMPLER_TYPE_TOP_K && params.top_k == 1);
+    if (!greedy) {
