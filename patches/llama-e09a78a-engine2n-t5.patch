+// engine2n: the gated delta net model's compressed indexer key for one token, the chain FILL -> CONCAT(k, fill) -> SET_ROWS(cache, f16)
+// -> GET_ROWS(cache first half, npool rows) -> CONT/ADD... (sum of the rows) -> SCALE -> RMS_NORM -> MUL(w) -> ROPE (multi/imrope)
+// -> SET_ROWS(cache second half, f16), in one block of 32 threads, each owning 4 consecutive channels as the separate ops would
+// compute them (the norm as rms_norm_f32<32, 1, vec, multiply>, the rope with rope_multi's pair work). Each thread reads back only
+// the cache channels it wrote itself, so the order of the separate ops is kept. Same values; 12 kernels -> 1.
+struct idx_k_pool_args {
+    const float *   k        = nullptr;  // [D] new key
+    float           fill     = 0.0f;     // the concat's second half
+    char *          cache    = nullptr;  // f16 rows of 2D: [key D | pooled D]
+    uint64_t        cache_nb1 = 0;
+    const int64_t * row_new  = nullptr;  // SET_ROWS index of the new row
+    const int32_t * pool_ids = nullptr;  // GET_ROWS indices (npool)
+    int             npool    = 0;
+    float           sc       = 1.0f, sb = 0.0f;
+    float           eps      = 0.0f;
+    const float *   w        = nullptr;  // [D] norm weight
+    float *         rope_out = nullptr;  // [D] rope result (f32)
+    const int64_t * row_pool = nullptr;  // SET_ROWS index of the pooled row
+};
