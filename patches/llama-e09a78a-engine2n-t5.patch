+    ggml_cuda_set_device(dev);
+    auto kernel = q8 != nullptr ? k_seg_moe_head<true> : k_seg_moe_head<false>;
+    // a persistent grid of as many 1024-thread blocks as stay resident
+    static int occ[2] = { -1, -1 };
+    int & o = occ[q8 != nullptr];
+    if (o < 0) {
+        if (cudaOccupancyMaxActiveBlocksPerMultiprocessor(&o, kernel, 1024, 0) != cudaSuccess) {
+            o = 0;
+        }
+        GGML_LOG_INFO("%s: %d blocks of 1024 per CU, %d CUs\n", __func__, o, ggml_cuda_info().devices[dev].nsm);
+    }
+    if (o <= 0) {
+        return false;
+    }
+    const int nblocks = o * ggml_cuda_info().devices[dev].nsm;
+    if (ctx.seg_ctr == nullptr) {
+        CUDA_CHECK(cudaMalloc(&ctx.seg_ctr, 64));
+        CUDA_CHECK(cudaMemsetAsync(ctx.seg_ctr, 0, 64, ctx.stream()));
+        ctx.seg_base = 0;
+    }
+    static const bool prefetch = [] { const char * e = getenv("GGML_CUDA_SEG_PREFETCH"); return !e || atoi(e) != 0; }();
+
+    const ggml_tensor * xs = sc->src[0];
+    const ggml_tensor * w  = mm->src[0];
+    const ggml_tensor * x  = pre->src[0];
+    const ggml_tensor * gw = pre->src[1];
+    seg_moe_head_args a = {};
+    a.w_dn = dn->src[0]->data; a.y_dn = (const block_q8_1 *) y_dn; a.dst_dn = (float *) dn->data;
+    a.nrows_dn = (int) dn->src[0]->ne[1]; a.stride_row_dn = (int) (dn->src[0]->nb[1] / ggml_type_size(dn->src[0]->type));
+    a.nblk_dn = (int) (dn->src[0]->ne[0] / QK_K);
+    a.xs = (const float *) xs->data; a.sxs1 = xs->nb[1] / sizeof(float); a.silu = (float *) si->data; a.ssi1 = si->nb[1] / sizeof(float);
+    a.ne_s = (int) si->ne[0];
+    memcpy(&a.s_scale, (const float *) sc->op_params + 0, sizeof(float));
+    memcpy(&a.s_bias,  (const float *) sc->op_params + 1, sizeof(float));
+    a.w_up = (const char *) w->data; a.stride_row_up = (int) (w->nb[1] / ggml_type_size(w->type));
+    a.gate = (float *) mm->data; a.sg1 = mm->nb[1] / sizeof(float);
+    a.x = (const float *) x->data; a.pre = (float *) pre->data;
+    a.sx0 = x->nb[0] / sizeof(float); a.sx1 = x->nb[1] / sizeof(float); a.sx2 = x->nb[2] / sizeof(float); a.sd1 = pre->nb[1] / sizeof(float);
+    a.sw0 = gw->nb[0] / sizeof(float); a.sw1 = gw->nb[1] / sizeof(float); a.scale = ggml_get_op_params_f32(pre, 0);
+    a.q8 = (block_q8_1 *) q8; a.n_up = (int) (x->ne[0] / 32);
+    a.w_r = (const nv_bfloat16 *) rt->src[0]->data; a.y_r = (const float *) rt->src[1]->data; a.dst_r = (float *) rt->data;
+    a.nrows_r = (int) rt->src[0]->ne[1]; a.ncols2_r = (int) (rt->src[0]->ne[0] / 2); a.stride_row_r = rt->src[0]->nb[1] / sizeof(nv_bfloat16);
+    a.ctr = ctx.seg_ctr; a.base = ctx.seg_base;
+    if (prefetch) {
+        a.pf0 = (const char *) w->data; a.pf0_bytes = ggml_nbytes(w);
+        a.pf1 = (const char *) rt->src[0]->data; a.pf1_bytes = ggml_nbytes(rt->src[0]);
+    }
+    a.never = 0;
+    // an ordinary launch of a grid that fits at once (the stream's earlier kernels are done when it starts, another process can
+    // only delay blocks). GGML_CUDA_SEG_COOP=1: cooperative launch, which guarantees residency but cost 2.5% of decode (11-06)
+    static const bool coop = [] { const char * e = getenv("GGML_CUDA_SEG_COOP"); return e && atoi(e) != 0; }();
+    if (coop) {
+        void * args[] = { &a };
+        if (cudaLaunchCooperativeKernel((const void *) kernel, dim3(nblocks), dim3(1024), args, 0, ctx.stream()) != cudaSuccess) {
+            (void) cudaGetLastError();
+            return false;
+        }
+    } else {
+        kernel<<<nblocks, 1024, 0, ctx.stream()>>>(a);
+        if (cudaGetLastError() != cudaSuccess) {
+            return false;
+        }
+    }
+    ctx.seg_base += 2u * (unsigned) nblocks;  // two barriers
+    return true;
+}
