+    if constexpr (nq > 0) {
+        float wq[nq];
+#pragma unroll
+        for (int k = 0; k < nq; ++k) {
+            wq[k] = __half2float(b[k].d) * b[k].qs[lane];
+        }
+#pragma unroll
+        for (int k = 0; k < nq; ++k) {
+#pragma unroll
+            for (int t = 0; t < nt; ++t) {
+                acc[t] += wq[k] * lo[t*n_lo + 32*k + lane];
+            }
+        }
+    } else {
+        for (int k = 0; k < n_qblocks; ++k) {
+            const float wk = __half2float(b[k].d) * b[k].qs[lane];
+#pragma unroll
+            for (int t = 0; t < nt; ++t) {
+                acc[t] += wk * lo[t*n_lo + 32*k + lane];
+            }
+        }
+    }
+
+    __shared__ float part[nt][HC_MIX_WARPS];
+#pragma unroll
+    for (int t = 0; t < nt; ++t) {
+        const float g = warp_reduce_sum<HC_MIX_WARP>(acc[t]);
+        if (lane == 0) {
+            part[t][warp] = xn[t*HC_MIX_HC*n_embd + s*n_embd + e] / (1.0f + expf(-g));
+        }
+    }
+    __syncthreads();
+
+    if (threadIdx.x < HC_MIX_UP_EMBD*nt) {
+        const int el = threadIdx.x % HC_MIX_UP_EMBD;
+        const int t  = threadIdx.x / HC_MIX_UP_EMBD;
+        float sum = 0.0f;
+#pragma unroll
+        for (int k = 0; k < HC_MIX_HC; ++k) {
+            sum += part[t][el*HC_MIX_HC + k];
+        }
+        dst[t*n_embd + blockIdx.x*HC_MIX_UP_EMBD + el] = pre_scale*sum;
+    }
+}
+
+// one warp per position and its HC_MIX_HC stream rows, a block takes HC_MIX_WARPS positions and keeps lo in shared memory
+template <int nq, int nt>
+static __global__ void hc_mix_up_pos(const char * __restrict__ w, const size_t row_bytes, const float * __restrict__ lo,
+        const float * __restrict__ xn, float * __restrict__ dst, const int n_embd, const int n_qblocks, const float pre_scale) {
+    const int lane = threadIdx.x % HC_MIX_WARP;
+    const int warp = threadIdx.x / HC_MIX_WARP;
+    const int e    = blockIdx.x*HC_MIX_WARPS + warp;
+    const int n_lo = n_qblocks*32;
+
+    extern __shared__ float lo_s[];  // [nt][n_lo]
+    for (int k = threadIdx.x; k < nt*n_lo; k += blockDim.x) {
+        lo_s[k] = lo[k];
+    }
+    __syncthreads();
+
+    float acc[HC_MIX_HC][nt] = {};
+#pragma unroll
+    for (int s = 0; s < HC_MIX_HC; ++s) {
+        const block_q8_0 * b = (const block_q8_0 *) (w + (size_t) (s*n_embd + e)*row_bytes);
+        if constexpr (nq > 0) {
+            float wq[nq];
+#pragma unroll
+            for (int k = 0; k < nq; ++k) {
+                wq[k] = __half2float(b[k].d) * b[k].qs[lane];
+            }
+#pragma unroll
+            for (int k = 0; k < nq; ++k) {
+#pragma unroll
+                for (int t = 0; t < nt; ++t) {
+                    acc[s][t] += wq[k] * lo_s[t*n_lo + 32*k + lane];
+                }
+            }
+        } else {
+            for (int k = 0; k < n_qblocks; ++k) {
+                const float wk = __half2float(b[k].d) * b[k].qs[lane];
+#pragma unroll
+                for (int t = 0; t < nt; ++t) {
+                    acc[s][t] += wk * lo_s[t*n_lo + 32*k + lane];
+                }
+            }
+        }
+    }
+
+#pragma unroll
+    for (int t = 0; t < nt; ++t) {
+        float sum = 0.0f;
+#pragma unroll
+        for (int s = 0; s < HC_MIX_HC; ++s) {
+            const float g = warp_reduce_sum<HC_MIX_WARP>(acc[s][t]);
+            sum += xn[t*HC_MIX_HC*n_embd + s*n_embd + e] / (1.0f + expf(-g));
+        }
+        if (lane == 0) {
+            dst[t*n_embd + e] = pre_scale*sum;
+        }
+    }
+}
+
+// GGML_CUDA_HC_MIX=1: fuse, rounding the activations as q8_1 like the unfused path (same quality, no measured 2-node gain);
+// GGML_CUDA_HC_MIX=f32: fuse with exact f32 activations (2-node MTP +2.5%, but KLD to the Q8_0 model 0.077 vs 0.071 and
+// higher PPL; the Q8_0 model's own PPL also rises with f32 hc activations). Off by default (RESULTS.md 2026-10-31).
+static const char * hc_mix_mode() {
+    static const char * v = getenv("GGML_CUDA_HC_MIX");
+    return v;
+}
+
+static bool hc_mix_disabled() {
+    return hc_mix_mode() == nullptr || strcmp(hc_mix_mode(), "0") == 0;
+}
+
+static bool hc_mix_overlap(const void * a, size_t na, const void * b, size_t nb) {
+    const char * pa = (const char *) a;
+    const char * pb = (const char *) b;
+    return pa < pb + nb && pb < pa + na;
+}
+
+bool ggml_cuda_hc_mix_match(const ggml_cgraph * cgraph, int i) {
+    if (hc_mix_disabled() || i + 7 > cgraph->n_nodes) {
+        return false;
+    }
+    if (ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size != HC_MIX_WARP) {
+        return false;
+    }
+    const ggml_tensor * down  = cgraph->nodes[i];
+    const ggml_tensor * view  = cgraph->nodes[i + 1];
+    const ggml_tensor * scale = cgraph->nodes[i + 2];
+    const ggml_tensor * silu  = cgraph->nodes[i + 3];
+    const ggml_tensor * up    = cgraph->nodes[i + 4];
+    const ggml_tensor * gate  = cgraph->nodes[i + 5];
+    const ggml_tensor * pre   = cgraph->nodes[i + 6];
+
+    if (down->op != GGML_OP_MUL_MAT || view->op != GGML_OP_VIEW || scale->op != GGML_OP_SCALE ||
+            silu->op != GGML_OP_UNARY || ggml_get_unary_op(silu) != GGML_UNARY_OP_SILU ||
+            up->op != GGML_OP_MUL_MAT || gate->op != GGML_OP_RESHAPE || pre->op != GGML_OP_DSV4_HC_PRE) {
+        return false;
+    }
+    if (!ggml_can_fuse_subgraph(cgraph, i, { GGML_OP_MUL_MAT, GGML_OP_VIEW, GGML_OP_SCALE, GGML_OP_UNARY,
+                GGML_OP_MUL_MAT, GGML_OP_RESHAPE, GGML_OP_DSV4_HC_PRE }, { i, i + 6 })) {
+        return false;
+    }
+    // edges
+    if (view->view_src != down || view->view_offs != 0 || scale->src[0] != view || silu->src[0] != scale ||
+            up->src[1] != silu || gate->src[0] != up || pre->src[1] != gate) {
+        return false;
+    }
+    // 1..HC_MIX_MAX_TOKENS tokens, contiguous f32 activations
+    const ggml_tensor * x = down->src[1];
+    const ggml_tensor * w_down = down->src[0];
+    const ggml_tensor * w_up = up->src[0];
+    const ggml_tensor * xn3 = pre->src[0];
+    const int64_t n_embd = xn3->ne[0];
+    const int64_t n_lo   = view->ne[0];
+    const int64_t nt     = x->ne[1];
+    if (nt < 1 || nt > HC_MIX_MAX_TOKENS) {
+        return false;
+    }
+    if (x->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) || x->ne[2] != 1 || x->ne[3] != 1 ||
+            xn3->type != GGML_TYPE_F32 || !ggml_is_contiguous(xn3) || xn3->data != x->data ||
+            xn3->ne[1] != HC_MIX_HC || xn3->ne[2] != nt || x->ne[0] != n_embd*HC_MIX_HC) {
+        return false;
+    }
+    if ((w_down->type != GGML_TYPE_Q6_K && w_down->type != GGML_TYPE_Q8_0) || !ggml_is_contiguous(w_down) ||
+            w_down->ne[0] != x->ne[0] || w_down->ne[0] % 256 != 0 || w_down->ne[2] != 1 || w_down->ne[1] < n_lo) {
+        return false;
+    }
+    if (w_up->type != GGML_TYPE_Q8_0 || !ggml_is_contiguous(w_up) || w_up->ne[0] != n_lo || n_lo % 32 != 0 ||
+            w_up->ne[1] != n_embd*HC_MIX_HC || w_up->ne[2] != 1 || n_embd % HC_MIX_WARPS != 0) {
+        return false;
+    }
+    if (ggml_get_op_params_i32(pre, 1) != 1 || view->ne[1] != nt || view->nb[1] != down->nb[1] ||
+            !ggml_is_contiguous(down) || down->ne[1] != nt || up->ne[1] != nt ||
+            !ggml_is_contiguous(pre) || pre->ne[0] != n_embd || pre->ne[1] != nt) {
+        return false;
+    }
+    // memory: lo goes to the up product's buffer, which is live until hc_pre and is not an input
+    const size_t raw_bytes = ggml_nbytes(down);
+    const size_t lo_bytes  = nt*n_lo*sizeof(float);
+    const size_t xn_bytes  = ggml_nbytes(x);
+    const size_t dst_bytes = ggml_nbytes(pre);
+    if (ggml_nbytes(up) < lo_bytes ||
+            hc_mix_overlap(up->data, lo_bytes, x->data, xn_bytes) || hc_mix_overlap(up->data, lo_bytes, down->data, raw_bytes) ||
+            hc_mix_overlap(down->data, raw_bytes, x->data, xn_bytes) ||
+            hc_mix_overlap(pre->data, dst_bytes, x->data, xn_bytes) || hc_mix_overlap(pre->data, dst_bytes, up->data, lo_bytes)) {
+        return false;
+    }
+    return true;
+}
+
+template <int nt, bool q8a>
+static void hc_mix_launch(ggml_backend_cuda_context & ctx, const ggml_tensor * w_down, const ggml_tensor * w_up, const float * xn,
+        float * raw, float * lo, float * dst, int n_rows, int n_lo, int n_groups, int n_embd, float s, float b, float pre_s) {
+    cudaStream_t stream = ctx.stream();
+    const dim3 block(HC_MIX_WARP*HC_MIX_WARPS);
+
+    const int n_x = nt*n_groups*256;
+    ggml_cuda_pool_alloc<float> xq(ctx.pool());
+    const float * xd = xn;
+    if constexpr (q8a) {
+        xq.alloc(n_x);
+        hc_mix_round_x<<<(n_x + 255)/256, 256, 0, stream>>>(xn, xq.get(), n_x);
+        CUDA_CHECK(cudaGetLastError());
+        xd = xq.get();
+    }
+    // more tokens: more rows per block, so each block reads the nt activation vectors for more rows
+    constexpr int rows = nt == 1 ? 2 : 4;
+    const dim3 grid_down((n_rows + rows - 1)/rows);
+    // qwen4exp: 10240 = 40 groups = 5 per warp
+    const bool g5 = n_groups == 5*HC_MIX_WARPS;
+    auto down_k = w_down->type == GGML_TYPE_Q6_K ? (g5 ? hc_mix_down<GGML_TYPE_Q6_K, 5, nt, rows, q8a> : hc_mix_down<GGML_TYPE_Q6_K, 0, nt, rows, q8a>)
+                                                 : (g5 ? hc_mix_down<GGML_TYPE_Q8_0, 5, nt, rows, q8a> : hc_mix_down<GGML_TYPE_Q8_0, 0, nt, rows, q8a>);
+    down_k<<<grid_down, block, 0, stream>>>((const char *) w_down->data, w_down->nb[1], xd, raw, lo, n_rows, n_lo, n_groups, s, b);
+    CUDA_CHECK(cudaGetLastError());
+
+    // qwen4exp: low rank 320 = 10 quant blocks
+    if constexpr (nt == 1) {
+        auto up_k = n_lo == 320 ? hc_mix_up_row<10, nt> : hc_mix_up_row<0, nt>;
+        up_k<<<n_embd/HC_MIX_UP_EMBD, block, 0, stream>>>((const char *) w_up->data, w_up->nb[1], lo, xn, dst, n_embd, n_lo/32, pre_s);
+    } else {
+        auto up_k = n_lo == 320 ? hc_mix_up_pos<10, nt> : hc_mix_up_pos<0, nt>;
+        up_k<<<n_embd/HC_MIX_WARPS, block, nt*n_lo*sizeof(float), stream>>>((const char *) w_up->data, w_up->nb[1], lo, xn, dst,
+                n_embd, n_lo/32, pre_s);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void ggml_cuda_op_hc_mix(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i) {
+    const ggml_tensor * down  = cgraph->nodes[i];
+    const ggml_tensor * view  = cgraph->nodes[i + 1];
+    const ggml_tensor * scale = cgraph->nodes[i + 2];
+    const ggml_tensor * up    = cgraph->nodes[i + 4];
+    ggml_tensor *       pre   = cgraph->nodes[i + 6];
+
+    const ggml_tensor * w_down = down->src[0];
+    const ggml_tensor * w_up   = up->src[0];
+    const float * xn  = (const float *) down->src[1]->data;
+    float *       raw = (float *) down->data;
+    float *       lo  = (float *) up->data;
+    float *       dst = (float *) pre->data;
+
+    const int nt       = (int) down->ne[1];
+    const int n_rows   = (int) w_down->ne[1];
+    const int n_lo     = (int) view->ne[0];
+    const int n_groups = (int) (w_down->ne[0] / 256);
+    const int n_embd   = (int) pre->ne[0];
+    const float s      = ggml_get_op_params_f32(scale, 0);
+    const float b      = ggml_get_op_params_f32(scale, 1);
+    const float pre_s  = ggml_get_op_params_f32(pre, 0);
+
+    static bool logged = false;
+    if (!logged) {
+        logged = true;
+        GGML_LOG_INFO("%s: fused hc mix: down %s [%d rows], up %s [%d rows of %d]\n", __func__,
+                ggml_type_name(w_down->type), n_rows, ggml_type_name(w_up->type), (int) w_up->ne[1], n_lo);
+    }
+    static int64_t n_calls = 0;
+    static const bool count = getenv("GGML_CUDA_HC_MIX_COUNT") != nullptr;  // debug: log every 1000 calls
+    if (count && ++n_calls % 1000 == 0) {
+        GGML_LOG_INFO("%s: %lld calls (this one %d tokens)\n", __func__, (long long) n_calls, nt);
+    }
+
+    static const bool f32 = strcmp(hc_mix_mode(), "f32") == 0;
+    cudaStream_t stream = ctx.stream();
+#define HC_MIX_LAUNCH(n) (f32 ? hc_mix_launch<n, false>(ctx, w_down, w_up, xn, raw, lo, dst, n_rows, n_lo, n_groups, n_embd, s, b, pre_s) \
+                              : hc_mix_launch<n, true >(ctx, w_down, w_up, xn, raw, lo, dst, n_rows, n_lo, n_groups, n_embd, s, b, pre_s))
+    switch (nt) {
+        case 1: HC_MIX_LAUNCH(1); break;
+        case 2: HC_MIX_LAUNCH(2); break;
+        case 3: HC_MIX_LAUNCH(3); break;
+        case 4: HC_MIX_LAUNCH(4); break;
+        default: GGML_ABORT("hc mix: %d tokens", nt);
+    }
+#undef HC_MIX_LAUNCH
+
+    // GGML_CUDA_HC_MIX_CHECK=<n>: compare the first n calls with a host reference in double (debug; needs HIP graphs off)
+    static int n_check = getenv("GGML_CUDA_HC_MIX_CHECK") ? atoi(getenv("GGML_CUDA_HC_MIX_CHECK")) : 0;
+    if (n_check > 0) {
+        n_check--;
+        CUDA_CHECK(cudaStreamSynchronize(stream));
+        const int64_t K = w_down->ne[0];
+        std::vector<char>  wd(ggml_nbytes(w_down)), wu(ggml_nbytes(w_up));
+        std::vector<float> hx(K*nt), hraw((size_t) n_rows*nt), hdst((size_t) n_embd*nt), row(K);
+        CUDA_CHECK(cudaMemcpy(wd.data(), w_down->data, wd.size(), cudaMemcpyDeviceToHost));
+        CUDA_CHECK(cudaMemcpy(wu.data(), w_up->data, wu.size(), cudaMemcpyDeviceToHost));
+        CUDA_CHECK(cudaMemcpy(hx.data(), xn, hx.size()*sizeof(float), cudaMemcpyDeviceToHost));
+        CUDA_CHECK(cudaMemcpy(hraw.data(), raw, hraw.size()*sizeof(float), cudaMemcpyDeviceToHost));
+        CUDA_CHECK(cudaMemcpy(hdst.data(), dst, hdst.size()*sizeof(float), cudaMemcpyDeviceToHost));
+        const auto * td = ggml_get_type_traits(w_down->type);
+        const auto * tu = ggml_get_type_traits(w_up->type);
+        double e_raw = 0, m_raw = 0, e_dst = 0, m_dst = 0;
+        // the reference rounds the activations the same way as the kernel (q8_1 unless GGML_CUDA_HC_MIX=f32)
+        auto q8_1_ref = [&](double * v, int n) {
+            for (int i0 = 0; i0 < n; i0 += 32) {
+                double amax = 0;
+                for (int i = i0; i < i0 + 32; ++i) {
+                    amax = std::max(amax, std::fabs(v[i]));
+                }
+                const float d = (float) amax / 127.0f;
+                const float dh = ggml_fp16_to_fp32(ggml_fp32_to_fp16(d));
+                for (int i = i0; i < i0 + 32; ++i) {
+                    v[i] = amax == 0 ? 0.0 : (double) roundf((float) v[i] / d) * dh;
+                }
+            }
+        };
+        for (int t = 0; t < nt; ++t) {
+            std::vector<double> xd(hx.begin() + t*K, hx.begin() + (t + 1)*K);
+            if (!f32) {
+                q8_1_ref(xd.data(), (int) K);
+            }
+            const double * x = xd.data();
+            const float * xr = hx.data() + t*K;  // hc_pre uses the unrounded xn
+            std::vector<double> lo_ref(n_lo), gate_ref((size_t) n_embd*HC_MIX_HC);
+            for (int r = 0; r < n_rows; ++r) {
+                td->to_float(wd.data() + r*w_down->nb[1], row.data(), K);
+                double acc = 0;
+                for (int64_t k = 0; k < K; ++k) {
+                    acc += (double) row[k]*x[k];
+                }
+                e_raw = std::max(e_raw, std::fabs(acc - hraw[(size_t) t*n_rows + r]));
+                m_raw = std::max(m_raw, std::fabs(acc));
+                if (r < n_lo) {
+                    const double v = s*acc + b;
+                    lo_ref[r] = v/(1.0 + std::exp(-v));
+                }
+            }
+            if (!f32) {
+                q8_1_ref(lo_ref.data(), n_lo);
+            }
+            for (int j = 0; j < n_embd*HC_MIX_HC; ++j) {
+                tu->to_float(wu.data() + j*w_up->nb[1], row.data(), n_lo);
+                double acc = 0;
+                for (int k = 0; k < n_lo; ++k) {
+                    acc += (double) row[k]*lo_ref[k];
+                }
+                gate_ref[j] = acc;
+            }
+            for (int e = 0; e < n_embd; ++e) {
+                double sum = 0;
+                for (int h = 0; h < HC_MIX_HC; ++h) {
+                    sum += xr[h*n_embd + e] / (1.0 + std::exp(-gate_ref[h*n_embd + e]));
+                }
+                sum *= pre_s;
+                e_dst = std::max(e_dst, std::fabs(sum - hdst[(size_t) t*n_embd + e]));
+                m_dst = std::max(m_dst, std::fabs(sum));
+            }
+        }
+        GGML_LOG_INFO("%s: check %s (%d tokens): raw max err %.3g (max |ref| %.3g), hc_pre max err %.3g (max |ref| %.3g)\n",
+                __func__, down->name, nt, e_raw, m_raw, e_dst, m_dst);
+    }
+}
