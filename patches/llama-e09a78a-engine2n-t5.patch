index 0000000..78a57f8
--- /dev/null
+++ b/ggml/src/ggml-cuda/hc-mix.cu
@@ -0,0 +1,532 @@
+#include "hc-mix.cuh"
+
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+static constexpr int HC_MIX_HC          = 4;   // hyper-connection streams
+static constexpr int HC_MIX_WARP        = 32;  // the kernels map lanes to the 32 values of a quant block
+static constexpr int HC_MIX_WARPS       = 8;
+static constexpr int HC_MIX_UP_EMBD     = HC_MIX_WARPS / HC_MIX_HC;  // embedding positions per up block
+static constexpr int HC_MIX_MAX_TOKENS  = 4;   // decode and MTP verify (3 drafts + 1)
+
+// round a value the way quantize_q8_1 does for the unfused mmvq path (32 values per block = the 32 lanes of a warp,
+// scale amax/127 stored as f16), so that the fused result keeps the unfused numerics
+static __device__ __forceinline__ float hc_mix_q8_1(const float x) {
+    const float amax = warp_reduce_max<HC_MIX_WARP>(fabsf(x));
+    const float d    = amax / 127.0f;
+    return amax == 0.0f ? 0.0f : roundf(x / d) * __half2float(__float2half(d));
+}
+
+// xq = xn rounded as q8_1, n a multiple of 32: one warp per 32 values
+static __global__ void hc_mix_round_x(const float * __restrict__ x, float * __restrict__ xq, const int n) {
+    const int i = blockIdx.x*blockDim.x + threadIdx.x;
+    if (i < n) {
+        xq[i] = hc_mix_q8_1(x[i]);
+    }
+}
+
+// blocks of hc_mix_down that have finished; the last one rounds lo and resets it
+static __device__ unsigned int hc_mix_down_done = 0;
+
+// one 256-value group g of a down row against the nt token vectors xv[t][k] = xn_t[256*g + lane + 32*k], k = 0..7
+// (a Q6_K half h takes its values lane, lane+32, lane+64, lane+96 = xv[t][4h + 0..3]); the weights are decoded once
+template <ggml_type type, int nt>
+static __device__ __forceinline__ void hc_mix_dot256(const char * row, int g, int lane, const float (&xv)[nt][8], float (&acc)[nt]) {
+    if constexpr (type == GGML_TYPE_Q6_K) {
+        const block_q6_K * b = (const block_q6_K *) row + g;
+        const float d = __half2float(b->d);
+#pragma unroll
+        for (int h = 0; h < 2; ++h) {
+            const int ql0 = b->ql[h*64 + lane];
+            const int ql1 = b->ql[h*64 + lane + 32];
+            const int qh  = b->qh[h*32 + lane];
+            const int8_t * sc = b->scales + h*8 + lane/16;
+            const float w1 = d*sc[0]*(((ql0 & 0xF) | (((qh >> 0) & 3) << 4)) - 32);
+            const float w2 = d*sc[2]*(((ql1 & 0xF) | (((qh >> 2) & 3) << 4)) - 32);
+            const float w3 = d*sc[4]*(((ql0 >>  4) | (((qh >> 4) & 3) << 4)) - 32);
+            const float w4 = d*sc[6]*(((ql1 >>  4) | (((qh >> 6) & 3) << 4)) - 32);
+#pragma unroll
+            for (int t = 0; t < nt; ++t) {
+                acc[t] += w1*xv[t][4*h + 0] + w2*xv[t][4*h + 1] + w3*xv[t][4*h + 2] + w4*xv[t][4*h + 3];
+            }
+        }
+    } else {
+        static_assert(type == GGML_TYPE_Q8_0, "hc mix: unsupported down type");
+        const block_q8_0 * b = (const block_q8_0 *) row + 8*g;
+#pragma unroll
+        for (int k = 0; k < 8; ++k) {
+            const float wk = __half2float(b[k].d) * b[k].qs[lane];
+#pragma unroll
+            for (int t = 0; t < nt; ++t) {
+                acc[t] += wk*xv[t][k];
+            }
+        }
+    }
+}
+
+// for each of nt tokens: raw_t[r] = down_inject[r] . xn_t; lo_t[r] = silu(scale*raw_t[r] + bias) for the first n_lo rows
+// (q8a: xn already rounded as q8_1 by hc_mix_round_x, and lo is rounded the same way at the end).
+// A block takes `rows` rows, which share the activation loads; its warps split the row length in 256-value groups.
+// gpw > 0: each warp takes exactly gpw groups, unrolled so that all their loads are in flight at once.
+template <ggml_type type, int gpw, int nt, int rows, bool q8a>
+static __global__ void hc_mix_down(const char * __restrict__ w, const size_t row_bytes, const float * __restrict__ xn,
+        float * __restrict__ raw, float * __restrict__ lo, const int n_rows, const int n_lo, const int n_groups,
+        const float scale, const float bias) {
+    const int lane = threadIdx.x % HC_MIX_WARP;
+    const int warp = threadIdx.x / HC_MIX_WARP;
