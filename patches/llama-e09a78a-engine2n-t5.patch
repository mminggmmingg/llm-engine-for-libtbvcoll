+    const int K    = n_groups*256;
+
+    float acc[rows][nt] = {};
+    auto step = [&](const int g) {
+        float xv[nt][8];
+#pragma unroll
+        for (int t = 0; t < nt; ++t) {
+#pragma unroll
+            for (int k = 0; k < 8; ++k) {
+                xv[t][k] = xn[t*K + g*256 + lane + 32*k];
+            }
+        }
+#pragma unroll
+        for (int r = 0; r < rows; ++r) {
+            if (r0 + r < n_rows) {
+                hc_mix_dot256<type, nt>(w + (size_t) (r0 + r)*row_bytes, g, lane, xv, acc[r]);
+            }
+        }
+    };
+    if constexpr (gpw > 0) {
+#pragma unroll
+        for (int j = 0; j < gpw; ++j) {
+            step(warp + j*HC_MIX_WARPS);
+        }
+    } else {
+        for (int g = warp; g < n_groups; g += HC_MIX_WARPS) {
+            step(g);
+        }
+    }
