+    const ggml_tensor * x = sc->src[0];
+    if (x->type != GGML_TYPE_F32 || sc->type != GGML_TYPE_F32 || si->type != GGML_TYPE_F32 || !ggml_is_quantized(mm->src[0]->type) ||
