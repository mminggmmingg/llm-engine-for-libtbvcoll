+#pragma unroll
+    for (int r = 0; r < rows; ++r) {
+#pragma unroll
+        for (int t = 0; t < nt; ++t) {
+            const float s = warp_reduce_sum<HC_MIX_WARP>(acc[r][t]);
+            if (lane == 0) {
+                part[r*nt + t][warp] = s;
+            }
+        }
+    }
