+        return false;
+    }
+    const ggml_tensor * sc = cgraph->nodes[i];
+    const ggml_tensor * si = cgraph->nodes[i + 1];
+    const ggml_tensor * mm = cgraph->nodes[i + 2];
+    if (sc->op != GGML_OP_SCALE || si->op != GGML_OP_UNARY || ggml_get_unary_op(si) != GGML_UNARY_OP_SILU ||
+            mm->op != GGML_OP_MUL_MAT || mm->src[1] != si || !ggml_can_fuse(cgraph, i, {GGML_OP_SCALE, GGML_OP_UNARY})) {
+        return false;
