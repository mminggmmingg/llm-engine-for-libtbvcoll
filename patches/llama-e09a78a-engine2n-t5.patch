+// warp gw of ngw reads its share of [p, p + bytes) in 512-byte rows, so it is in L2 / MALL when a later stage reads it
+static __device__ __forceinline__ int seg_touch(const char * p, const size_t bytes, const int gw, const int ngw, const int lane) {
+    int s = 0;
+    for (size_t r = gw; r < bytes / 512; r += ngw) {
+        const int4 v = *(const int4 *) (p + r*512 + lane*16);
+        s ^= v.x ^ v.w;
+    }
+    return s;
