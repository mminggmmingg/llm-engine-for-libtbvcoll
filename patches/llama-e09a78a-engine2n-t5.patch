+static __global__ void k_comm_partial_out(const float * src, float * dst, const int64_t n, unsigned * flag, const unsigned seq,
+        uint64_t * ts) {
+    const uint64_t t0 = ts != nullptr && threadIdx.x == 0 ? ggml_cuda_realtime() : 0;
+    for (int64_t i = threadIdx.x; i < n; i += blockDim.x) {
+        dst[i] = src[i];
+    }
+#if defined(GGML_USE_HIP)
+    __threadfence_system();
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        if (ts != nullptr) {
+            ts[0] = t0;
+            ts[1] = ggml_cuda_realtime();
+        }
+        __hip_atomic_store(flag, seq, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_SYSTEM);
+    }
+#else
+    GGML_UNUSED(flag); GGML_UNUSED(seq); GGML_UNUSED(t0);
+#endif
+}
+
+static __global__ void k_comm_wait_add(float * dst, const float * src, const int64_t n, const unsigned * flag, const unsigned seq,
+        uint64_t * ts) {
+    uint64_t t2 = 0;
+    uint64_t t3 = 0;
+#if defined(GGML_USE_HIP)
+    if (threadIdx.x == 0) {
+        t2 = ts != nullptr ? ggml_cuda_realtime() : 0;
+        while (__hip_atomic_load(flag, __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_SYSTEM) < seq) {
+            __builtin_amdgcn_s_sleep(1);
+        }
+        t3 = ts != nullptr ? ggml_cuda_realtime() : 0;
+    }
+    __syncthreads();
+#else
+    GGML_UNUSED(flag); GGML_UNUSED(seq);
+#endif
+    for (int64_t i = threadIdx.x; i < n; i += blockDim.x) {
+        dst[i] = dst[i] + src[i];
+    }
+    if (ts != nullptr) {
+        __syncthreads();
+        if (threadIdx.x == 0) {
+            ts[2] = t2;
+            ts[3] = t3;
+            ts[4] = ggml_cuda_realtime();
+        }
+    }
+}
