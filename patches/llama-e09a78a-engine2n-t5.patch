+// engine2n: the same loop as the common sampler's greedy path (largest value, then its first index) so the token is the same
+static void ggml_argmax_row_f32(const float * x, int64_t n, float * val, int32_t * idx) {
+    float mx[8];
+    for (int l = 0; l < 8; ++l) {
+        mx[l] = -INFINITY;
+    }
+    int64_t i = 0;
+    for (; i + 8 <= n; i += 8) {
+        for (int l = 0; l < 8; ++l) {
+            mx[l] = x[i + l] > mx[l] ? x[i + l] : mx[l];
+        }
+    }
+    float m = -INFINITY;
+    for (int l = 0; l < 8; ++l) {
+        m = mx[l] > m ? mx[l] : m;
+    }
+    for (; i < n; ++i) {
+        m = x[i] > m ? x[i] : m;
+    }
+    int64_t j = 0;
+    while (j < n - 1 && x[j] != m) {
+        ++j;
+    }
+    *val = m;
+    *idx = (int32_t) j;
+}
+
+// returns false when it does not take this tensor (then the host path below)
+typedef bool (*ggml_backend_tensor_argmax_rows_t)(const struct ggml_tensor * tensor, int64_t n_rows, float * vals, int32_t * idx);
+
+void ggml_backend_tensor_argmax_rows(ggml_backend_t backend, const ggml_tensor * tensor, int64_t n_rows, float * vals, int32_t * idx) {
+    GGML_ASSERT(tensor->type == GGML_TYPE_F32 && ggml_is_contiguous(tensor));
+    GGML_ASSERT(n_rows >= 0 && n_rows <= ggml_nrows(tensor));
+    if (n_rows == 0) {
+        return;
+    }
+
+    if (ggml_backend_is_meta(backend)) {
+        const ggml_backend_meta_split_state split_state = ggml_backend_meta_get_split_state(tensor, /*assume_sync =*/ false);
+        if (split_state.axis == GGML_BACKEND_SPLIT_AXIS_MIRRORED) {
+            ggml_backend_tensor_argmax_rows(ggml_backend_meta_simple_backend(backend, 0),
+                ggml_backend_meta_buffer_simple_tensor(tensor, 0), n_rows, vals, idx);
+            return;
+        }
+        GGML_ASSERT(split_state.axis == GGML_BACKEND_SPLIT_AXIS_0);
+        GGML_ASSERT(split_state.n_segments == 1 && split_state.nr[0] == 1);
+
+        // ask every device at once (each rpc device has its own connection; the first waits for its GPU anyway),
+        // GGML_META_ARGMAX_SERIAL=1: one after the other as before
+        static const bool serial = getenv("GGML_META_ARGMAX_SERIAL") != nullptr;
+        const size_t n_backends = ggml_backend_meta_n_backends(backend);
+        std::vector<std::vector<float>>   vals_j(n_backends, std::vector<float>(n_rows));
+        std::vector<std::vector<int32_t>> idx_j(n_backends, std::vector<int32_t>(n_rows));
+        auto ask = [&](size_t j) {
+            ggml_backend_tensor_argmax_rows(ggml_backend_meta_simple_backend(backend, j), ggml_backend_meta_buffer_simple_tensor(tensor, j),
+                n_rows, vals_j[j].data(), idx_j[j].data());
+        };
+        std::vector<std::thread> others;
+        for (size_t j = 1; j < n_backends && !serial; j++) {
+            if (ggml_backend_meta_buffer_simple_tensor(tensor, j)->ne[0] > 0) {
+                others.emplace_back(ask, j);
+            }
+        }
+        for (size_t j = 0; j < (serial ? n_backends : 1); j++) {
+            if (ggml_backend_meta_buffer_simple_tensor(tensor, j)->ne[0] > 0) {
+                ask(j);
+            }
+        }
+        for (auto & t : others) {
+            t.join();
+        }
+
+        // devices hold consecutive slices of each row in device order: a later slice wins only with a larger value,
+        // which keeps the first index of the largest value like one argmax over the whole row
+        int64_t i0 = 0;
+        for (size_t j = 0; j < n_backends; j++) {
+            const ggml_tensor * simple_tensor = ggml_backend_meta_buffer_simple_tensor(tensor, j);
+            if (simple_tensor->ne[0] == 0) {
+                continue;
+            }
+            for (int64_t r = 0; r < n_rows; r++) {
+                if (i0 == 0 || vals_j[j][r] > vals[r]) {
+                    vals[r] = vals_j[j][r];
+                    idx[r]  = (int32_t) (i0 + idx_j[j][r]);
+                }
+            }
+            i0 += simple_tensor->ne[0];
+        }
+        GGML_ASSERT(i0 == tensor->ne[0]);
+        return;
+    }
+
+    if (backend != nullptr) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(backend);
+        ggml_backend_reg_t reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+        ggml_backend_tensor_argmax_rows_t fn = reg ? (ggml_backend_tensor_argmax_rows_t)
+            ggml_backend_reg_get_proc_address(reg, "ggml_backend_tensor_argmax_rows") : nullptr;
+        if (fn != nullptr && fn(tensor, n_rows, vals, idx)) {
+            return;
+        }
+        ggml_backend_synchronize(backend);
+    }
+
+    const int64_t ne0 = tensor->ne[0];
+    std::vector<float> rows(n_rows*ne0);
+    ggml_backend_tensor_get(tensor, rows.data(), 0, rows.size()*sizeof(float));
+    for (int64_t r = 0; r < n_rows; r++) {
+        ggml_argmax_row_f32(rows.data() + r*ne0, ne0, vals + r, idx + r);
+    }
+}
