+// queue: copy n f32 from device src to host dst (comm host memory), then *flag = seq
+static bool ggml_backend_cuda_comm_partial_out(ggml_backend_t backend, const void * src, void * dst, int64_t n, void * flag, uint32_t seq) {
+    ggml_backend_cuda_context * ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_cuda_set_device(ctx->device);
+    k_comm_partial_out<<<1, 1024, 0, ctx->stream()>>>((const float *) src, (float *) dst, n, (unsigned *) flag, seq,
+        ggml_cuda_comm_ts_slot(seq));
+    return cudaGetLastError() == cudaSuccess;
+}
+
+// queue: wait until *flag >= seq (comm host memory), then dst += src (n f32, src in comm host memory)
+static bool ggml_backend_cuda_comm_wait_add(ggml_backend_t backend, void * dst, const void * src, int64_t n, const void * flag, uint32_t seq) {
+    ggml_backend_cuda_context * ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_cuda_set_device(ctx->device);
+    k_comm_wait_add<<<1, 1024, 0, ctx->stream()>>>((float *) dst, (const float *) src, n, (const unsigned *) flag, seq,
+        ggml_cuda_comm_ts_slot(seq));
+    return cudaGetLastError() == cudaSuccess;
+}
