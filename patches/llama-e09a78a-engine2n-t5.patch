+    ggml_cuda_q8_1_cache_note_range(*ctx, (const char *) dst, (const char *) dst + n*sizeof(float));
+    ggml_cuda_comm_flush_deferred(*ctx);
+    static const bool defer = (getenv("GGML_CUDA_COMM_DEFER") != nullptr && atoi(getenv("GGML_CUDA_COMM_DEFER")) != 0) ||
+        ggml_cuda_comm_fuse_on();
+    if (defer) {
+        ctx->comm_deferred = { true, (float *) dst, (const float *) src, n, (const unsigned *) flag, seq };
+        return true;
+    }
+    k_comm_wait_add<<<1, 1024, 0, ctx->stream()>>>((float *) dst, (const float *) src, n, (const unsigned *) flag, seq,
+        ggml_cuda_comm_ts_slot(seq));
+    return cudaGetLastError() == cudaSuccess;
+}
+
+// GGML_CUDA_COMM_TS: the stamps of allreduce seq (GPU ticks [0..4], see above), or nullptr when off
+static const uint64_t * ggml_backend_cuda_comm_ts_get(uint32_t seq) {
+    return ggml_cuda_comm_ts_slot(seq);
+}
+
+static __global__ void k_comm_ts_calib(const int64_t * host_us, uint64_t * out, unsigned * done, const int n) {
+#if defined(GGML_USE_HIP)
+    for (int i = 0; i < n; i++) {
+        const uint64_t g0 = ggml_cuda_realtime();
+        const int64_t  h  = __hip_atomic_load(host_us, __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_SYSTEM);
+        const uint64_t g1 = ggml_cuda_realtime();
+        out[3*i + 0] = g0;
+        out[3*i + 1] = (uint64_t) h;
+        out[3*i + 2] = g1;
+        for (int k = 0; k < 4; k++) {
+            __builtin_amdgcn_s_sleep(127);  // ~3 us each
+        }
+    }
+    __threadfence_system();
+    __hip_atomic_store(done, 1u, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_SYSTEM);
+#else
+    GGML_UNUSED(host_us); GGML_UNUSED(out); GGML_UNUSED(done); GGML_UNUSED(n);
+#endif
+}
+
+// GGML_CUDA_COMM_TS: one (host us, GPU tick) pair. A kernel on its own stream samples a host time that this thread keeps
+// rewriting; of 6 samples ~12 us apart the one read closest to its writing (largest host - GPU) is kept, so the host side
+// lags by about the CPU -> GPU visibility delay (~1 us). This thread spins for those ~80 us.
+static bool ggml_backend_cuda_comm_ts_calib(ggml_backend_t backend, int64_t * host_us, uint64_t * gpu_tick) {
+#if defined(GGML_USE_HIP)
+    constexpr int n = 6;
+    static int64_t *   hv     = nullptr;
+    static hipStream_t stream = nullptr;
+    if (hv == nullptr) {
+        hv = (int64_t *) ggml_backend_cuda_comm_host_alloc(64 + 3*n*sizeof(uint64_t));
+        if (hv == nullptr || hipStreamCreateWithFlags(&stream, hipStreamNonBlocking) != hipSuccess) {
+            return false;
+        }
+    }
+    ggml_backend_cuda_context * ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_cuda_set_device(ctx->device);
+    unsigned * done = (unsigned *) (hv + 4);
+    uint64_t * out  = (uint64_t *) (hv + 8);
+    __atomic_store_n(done, 0u, __ATOMIC_SEQ_CST);
+    __atomic_store_n(hv, ggml_time_us(), __ATOMIC_SEQ_CST);
+    k_comm_ts_calib<<<1, 1, 0, stream>>>(hv, out, done, n);
+    if (cudaGetLastError() != cudaSuccess) {
+        return false;
+    }
+    while (__atomic_load_n(done, __ATOMIC_ACQUIRE) == 0) {
+        __atomic_store_n(hv, ggml_time_us(), __ATOMIC_SEQ_CST);
+    }
+    CUDA_CHECK(hipStreamSynchronize(stream));
+    double best = -1e300;
+    for (int i = 0; i < n; i++) {
+        const uint64_t g = (out[3*i] + out[3*i + 2])/2;
+        const double   d = (double) (int64_t) out[3*i + 1] - g*0.01;
+        if (d > best) {
+            best      = d;
+            *host_us  = (int64_t) out[3*i + 1];
+            *gpu_tick = g;
+        }
+    }
+    return true;
+#else
+    GGML_UNUSED(backend); GGML_UNUSED(host_us); GGML_UNUSED(gpu_tick);
+    return false;
+#endif
+}
+
+// engine2n: ggml_backend_tensor_argmax_rows for a tensor in device memory (the rpc server's ARGMAX_ROWS): one block per row,
+// the largest value and its first index like the common sampler's greedy loop (NaN never wins, -inf ties go to the first index,
+// all NaN gives the last index), so the token is the same as the host path's. Only 8 bytes per row cross to the host.
+// GGML_CUDA_NO_ARGMAX_ROWS=1: host path (the logits are copied).
+static __global__ void k_argmax_rows_first(const float * x, const int64_t ncols, const int64_t stride, float * vals, int32_t * idx) {
+    const float * r = x + blockIdx.x*stride;
+    float best = -INFINITY;
+    int   bi   = INT_MAX;
+    for (int64_t c = threadIdx.x; c < ncols; c += blockDim.x) {
+        const float v = r[c];
+        if (v > best || (v == best && (int) c < bi)) {
+            best = v;
+            bi   = (int) c;
+        }
+    }
+    auto take = [&](float ov, int oi) {
+        if (ov > best || (ov == best && oi < bi)) {
+            best = ov;
+            bi   = oi;
+        }
+    };
+#pragma unroll
+    for (int off = WARP_SIZE/2; off > 0; off >>= 1) {
+        take(__shfl_xor_sync(0xFFFFFFFF, best, off, WARP_SIZE), __shfl_xor_sync(0xFFFFFFFF, bi, off, WARP_SIZE));
+    }
+    __shared__ float sv[1024/WARP_SIZE];
+    __shared__ int   si[1024/WARP_SIZE];
+    const int lane = threadIdx.x % WARP_SIZE;
+    const int warp = threadIdx.x / WARP_SIZE;
+    if (lane == 0) {
+        sv[warp] = best;
+        si[warp] = bi;
+    }
+    __syncthreads();
+    if (warp == 0) {
+        const int nw = blockDim.x / WARP_SIZE;
+        best = lane < nw ? sv[lane] : -INFINITY;
+        bi   = lane < nw ? si[lane] : INT_MAX;
+#pragma unroll
+        for (int off = WARP_SIZE/2; off > 0; off >>= 1) {
+            take(__shfl_xor_sync(0xFFFFFFFF, best, off, WARP_SIZE), __shfl_xor_sync(0xFFFFFFFF, bi, off, WARP_SIZE));
+        }
+        if (lane == 0) {
+            vals[blockIdx.x] = best;
+            idx[blockIdx.x]  = bi == INT_MAX ? (int32_t) (ncols - 1) : bi;
+        }
+    }
+}
+
+static bool ggml_backend_cuda_tensor_argmax_rows(const ggml_tensor * tensor, int64_t n_rows, float * vals, int32_t * idx) {
+    static const bool off = getenv("GGML_CUDA_NO_ARGMAX_ROWS") != nullptr;
+    constexpr int64_t max_rows = 64;
+    if (off || tensor->buffer == nullptr || !ggml_backend_buffer_is_cuda(tensor->buffer) || n_rows > max_rows ||
+            tensor->type != GGML_TYPE_F32 || tensor->nb[0] != sizeof(float)) {
+        return false;
+    }
+    const int device = ((ggml_backend_cuda_buffer_context *) tensor->buffer->context)->device;
+    ggml_cuda_set_device(device);
+    CUDA_CHECK(cudaDeviceSynchronize());  // the compute that wrote the tensor (its streams do not block the null stream)
+    static float *   d_vals[GGML_CUDA_MAX_DEVICES] = {};
+    static int32_t * d_idx[GGML_CUDA_MAX_DEVICES]  = {};
+    if (d_vals[device] == nullptr) {
+        CUDA_CHECK(cudaMalloc(&d_vals[device], max_rows*sizeof(float)));
+        CUDA_CHECK(cudaMalloc(&d_idx[device],  max_rows*sizeof(int32_t)));
+    }
+    k_argmax_rows_first<<<n_rows, 1024, 0, 0>>>((const float *) tensor->data, tensor->ne[0], tensor->nb[1] / sizeof(float),
+        d_vals[device], d_idx[device]);
+    CUDA_CHECK(cudaMemcpy(vals, d_vals[device], n_rows*sizeof(float),   cudaMemcpyDeviceToHost));
+    CUDA_CHECK(cudaMemcpy(idx,  d_idx[device],  n_rows*sizeof(int32_t), cudaMemcpyDeviceToHost));
+    return true;
+}
