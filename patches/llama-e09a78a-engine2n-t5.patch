+static __device__ __forceinline__ uint64_t ggml_cuda_realtime() {
+#if defined(GGML_USE_HIP)
+    return wall_clock64();  // constant-rate counter (s_sendmsg_rtn GET_REALTIME on gfx11), 100 MHz on gfx1151
+#else
+    return 0;
+#endif
+}
