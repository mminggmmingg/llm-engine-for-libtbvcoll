+// engine2n: GGML_RPC_TRACE=<file> ("{port}" is replaced by the server port; the scripts use /dev/shm/ggml-rpc-trace-{port}.bin)
+// in an RPC server, GGML_RPC_TRACE_CLIENT=<file> in the client (every command it sends, plus llama_decode phases):
+// an mmap'd ring of 64-byte records for the inference watcher (tools/watch, Rust), written for the whole run with a few stores
+// per event — nothing is flushed or rewritten during the run. Records: every command the server handles (wait start, start,
+// end), every allreduce's host times and bytes, the helper thread's receive of the peer's partial, the allreduce kernels' GPU
+// stamps (GGML_CUDA_COMM_TS, which this turns on) and a (host us, GPU tick) pair every 250 ms from a background thread.
+// GGML_RPC_TRACE_RECS: ring size in records (default 1M = 64 MiB). A record is complete when its idx equals (index + 1) mod 2^32.
+enum rpc_trace_type : uint32_t {
+    RPC_TRACE_CMD     = 1,  // a = command;            t: wait start, start, end
+    RPC_TRACE_AR      = 2,  // a = seq, b = wire bytes; t: entry, previous receive done, partial on host, in send buffer, posted, return
+    RPC_TRACE_AR_SYNC = 3,  // a = seq, b = wire bytes; t: entry, previous receive done, partial on host, exchange done, return
+    RPC_TRACE_GPU     = 4,  // a = seq;                 t: GPU ticks copy-out start/end, wait start, peer's flag seen, add end
+    RPC_TRACE_CAL     = 5,  //                          t: host us, GPU tick
+    RPC_TRACE_RECV    = 6,  // a = seq, b = bytes;      t: receive start, partial landed (flag set)
+    // client (GGML_RPC_TRACE_CLIENT in llama-server / llama-bench)
+    RPC_TRACE_CCMD    = 7,  // a = command, b = endpoint; t: queued, send start, done (response received for commands with one)
+    RPC_TRACE_ENDP    = 8,  // a = endpoint;           t: the endpoint string (48 bytes)
+    RPC_TRACE_DECODE  = 9,  // a = tokens, b = outputs; t: llama_decode start, end
+    RPC_TRACE_UBATCH  = 10, // a = tokens, b = graph reused; t: start, graph ready, inputs set, compute launched
+    RPC_TRACE_SYNC    = 11, //                          t: llama_context::synchronize start, end
+};
+struct rpc_trace_rec {
+    std::atomic<uint32_t> idx;
+    uint32_t              type;
+    uint32_t              a;
+    uint32_t              b;
+    int64_t               t[6];
+};
+static_assert(sizeof(rpc_trace_rec) == 64, "rpc_trace_rec must be 64 bytes");
+struct rpc_trace_hdr {
+    char                  magic[8];  // "GGRPCTR1"
+    uint32_t              version;
+    uint32_t              rec_size;
+    uint64_t              capacity;
+    std::atomic<uint64_t> count;     // records reserved so far
+    int64_t               t_open;    // host us (ggml_time_us, CLOCK_MONOTONIC) at open
+    int32_t               pid;
+    int32_t               port;
+    char                  host[64];
+};
+static rpc_trace_hdr * g_trace_hdr  = nullptr;
+static rpc_trace_rec * g_trace_recs = nullptr;
+
+static bool rpc_trace_on() {
+    return g_trace_recs != nullptr;
+}
+
+static void rpc_trace(uint32_t type, uint32_t a, uint32_t b, int64_t t0, int64_t t1 = 0, int64_t t2 = 0, int64_t t3 = 0,
+        int64_t t4 = 0, int64_t t5 = 0) {
+    if (g_trace_recs == nullptr) {
+        return;
+    }
+    const uint64_t  i = g_trace_hdr->count.fetch_add(1, std::memory_order_relaxed);
+    rpc_trace_rec & r = g_trace_recs[i % g_trace_hdr->capacity];
+    r.idx.store(0, std::memory_order_relaxed);
+    r.type = type; r.a = a; r.b = b;
+    r.t[0] = t0; r.t[1] = t1; r.t[2] = t2; r.t[3] = t3; r.t[4] = t4; r.t[5] = t5;
+    r.idx.store((uint32_t) (i + 1), std::memory_order_release);
+}
+
+static void rpc_trace_open(const char * env_name, int port) {
+#if defined(__linux__)
+    const char * env = getenv(env_name);
+    if (env == nullptr || *env == 0) {
+        return;
+    }
+    std::string path = env;
+    const size_t at = path.find("{port}");
+    if (at != std::string::npos) {
+        path.replace(at, 6, std::to_string(port));
