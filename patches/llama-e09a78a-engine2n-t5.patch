+// GGML_CUDA_SKIP_OPS=<op,...>: for timing only, the results are wrong. Nodes whose op name or op description
+// (unary/glu name) is listed are not launched; a leading '!' skips every op except the listed ones ("!" alone skips all).
+// "w:<text>" matches nodes whose first source (the weight of a matmul) has <text> in its name.
+// The decode time an op class removes is its cost.
+static bool ggml_cuda_skip_op(const ggml_tensor * node) {
+    static const std::pair<bool, std::vector<std::string>> cfg = [] {
+        std::pair<bool, std::vector<std::string>> c{false, {}};
+        const char * env = getenv("GGML_CUDA_SKIP_OPS");
+        if (env == nullptr || *env == 0) {
+            return c;
+        }
+        std::string s = env;
+        if (s[0] == '!') {
+            c.first = true;
+            s = s.substr(1);
+        }
+        for (size_t p = 0; p < s.size();) {
+            size_t q = s.find(',', p);
+            q = q == std::string::npos ? s.size() : q;
+            if (q > p) {
+                c.second.push_back(s.substr(p, q - p));
+            }
+            p = q + 1;
+        }
+        GGML_LOG_INFO("%s: GGML_CUDA_SKIP_OPS=%s (timing only, results are wrong)\n", __func__, env);
+        return c;
+    }();
+    if (!cfg.first && cfg.second.empty()) {
+        return false;
+    }
+    bool listed = false;
+    for (const std::string & o : cfg.second) {
+        if (o.rfind("w:", 0) == 0) {
+            listed = listed || (node->src[0] != nullptr && strstr(node->src[0]->name, o.c_str() + 2) != nullptr);
+        } else {
+            listed = listed || o == ggml_op_name(node->op) || o == ggml_op_desc(node);
+        }
+    }
+    return cfg.first ? !listed : listed;
