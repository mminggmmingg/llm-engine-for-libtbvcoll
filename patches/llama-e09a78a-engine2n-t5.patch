+#else
+    GGML_UNUSED(flag); GGML_UNUSED(seq);
+#endif
+    for (int64_t i = threadIdx.x; i < n; i += blockDim.x) {
+        dst[i] = dst[i] + src[i];
+    }
+    if (ts != nullptr) {
+        __syncthreads();
+        if (threadIdx.x == 0) {
+            ts[2] = t2;
+            ts[3] = t3;
+            ts[4] = ggml_cuda_realtime();
