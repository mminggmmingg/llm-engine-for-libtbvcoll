+// one row of mul_mat_vec_q as it runs on RDNA (nwarps 1, rows_per_block 1, one column): the same loop and warp sum
+template <int qk, int qi, int vdr, typename vec_dot_t>
+static __device__ __forceinline__ float seg_mmvq_row(vec_dot_t vec_dot, const void * vx, const block_q8_1 * y, const int kbx_offset,
+        const int blocks_per_row_x, const int lane) {
+    constexpr int blocks_per_iter = vdr*32/qi;
+    float tmp = 0.0f;
+    for (int kbx = lane / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const int kqs = vdr * (lane % (qi/vdr));
+        tmp += vec_dot(vx, &y[kby], kbx_offset + kbx, kqs);
+    }
+    return warp_reduce_sum<32>(tmp);
