+static void * ggml_cuda_q8_1_cache_reserve(ggml_backend_cuda_context & ctx, const ggml_tensor * y) {
+    auto & qc = ctx.q8_1_cache;
+    const int slot = qc.next;
+    auto & e = qc.slots[slot];
