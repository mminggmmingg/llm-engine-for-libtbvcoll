+        const int r = r0 + threadIdx.x / nt;
+        const int t = threadIdx.x % nt;
+        if (r < n_rows) {
+            float s = 0.0f;
+#pragma unroll
+            for (int k = 0; k < HC_MIX_WARPS; ++k) {
+                s += part[threadIdx.x][k];
+            }
+            raw[t*n_rows + r] = s;
+            if (r < n_lo) {
+                const float v = scale*s + bias;
+                lo[t*n_lo + r] = v / (1.0f + expf(-v));
+            }
+        }
+    }
+
+    if constexpr (q8a) {
+        // the last block to finish rounds all of lo as q8_1 (the input of the up matmul in the unfused graph)
+        __shared__ bool last;
+        __threadfence();
+        __syncthreads();
+        if (threadIdx.x == 0) {
+            last = atomicAdd(&hc_mix_down_done, 1u) == gridDim.x - 1;
+        }
+        __syncthreads();
+        if (last) {
+            __threadfence();
+            volatile float * lv = lo;
+            for (int k = threadIdx.x; k < nt*n_lo; k += blockDim.x) {  // n_lo is a multiple of 32: warps take whole blocks
+                lv[k] = hc_mix_q8_1(lv[k]);
+            }
+            if (threadIdx.x == 0) {
+                hc_mix_down_done = 0;
+            }
+        }
+    }
+}
+
+// for each of nt tokens: gate_t[s*n_embd + e] = up[s*n_embd + e] . lo_t (Q8_0 rows of n_lo values);
+// dst_t[e] = pre_scale * sum_s xn_t[s*n_embd + e] * sigmoid(gate_t[s*n_embd + e]).
+// nq > 0: rows of exactly nq quant blocks, unrolled so that all their loads are in flight at once.
+// Two layouts (rocprofv3, gfx1151, 10240 rows of 320): one warp per row reading lo from L2 is faster for one token
+// (22 vs 29 us), one warp per position with lo in shared memory for four (30 vs 39 us).
+
+// one warp per (position, stream) row, a block takes HC_MIX_UP_EMBD positions
+template <int nq, int nt>
+static __global__ void hc_mix_up_row(const char * __restrict__ w, const size_t row_bytes, const float * __restrict__ lo,
+        const float * __restrict__ xn, float * __restrict__ dst, const int n_embd, const int n_qblocks, const float pre_scale) {
+    const int lane = threadIdx.x % HC_MIX_WARP;
+    const int warp = threadIdx.x / HC_MIX_WARP;
+    const int s    = warp % HC_MIX_HC;
+    const int e    = blockIdx.x*HC_MIX_UP_EMBD + warp / HC_MIX_HC;
+    const int n_lo = n_qblocks*32;
+
+    const block_q8_0 * b = (const block_q8_0 *) (w + (size_t) (s*n_embd + e)*row_bytes);
