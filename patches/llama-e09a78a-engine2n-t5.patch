+/* engine2n: shared expert gate tail, SIGMOID(g) -> MUL(shexp, sigmoid) -> ADD(moe_out, gated) in one kernel with the values
+   of the three ops: op_sigmoid as in the SIGMOID unary, and the product rounded before the sum like the two binary kernels
+   (HIP contracts a*b + c into an FMA by default, which changed ~20% of the outputs by 1 ulp). */
+static __global__ void k_shexp_gate_tail(const float * g, const float * shexp, const float * moe, float * dst, const int64_t ne0,
+        const int64_t sg1, const int64_t ss1, const int64_t sm1, const int64_t sd1) {
+#pragma clang fp contract(off)
+    const int64_t i0 = (int64_t) blockDim.x*blockIdx.x + threadIdx.x;
+    const int64_t i1 = blockIdx.y;
+    if (i0 >= ne0) {
+        return;
+    }
+    const float sig = op_sigmoid(g[i1*sg1]);
+    const float m   = shexp[i1*ss1 + i0] * sig;
+    dst[i1*sd1 + i0] = moe[i1*sm1 + i0] + m;
+}
+
+void ggml_cuda_op_shexp_gate_tail(ggml_backend_cuda_context & ctx, const ggml_tensor * g, const ggml_tensor * shexp,
+        const ggml_tensor * moe, ggml_tensor * dst) {
+    const int64_t ne0 = dst->ne[0];
+    const int64_t ne1 = dst->ne[1];
+    const dim3 grid((ne0 + 255)/256, ne1, 1);
+    k_shexp_gate_tail<<<grid, 256, 0, ctx.stream()>>>((const float *) g->data, (const float *) shexp->data, (const float *) moe->data,
+        (float *) dst->data, ne0, g->nb[1]/sizeof(float), shexp->nb[1]/sizeof(float), moe->nb[1]/sizeof(float), dst->nb[1]/sizeof(float));
+}
+
+// engine2n: MUL_MAT(gate weight [ncols, 1], y) -> SIGMOID -> MUL(shexp, .) -> ADD(moe_out, .) in one kernel: each block
+// computes its token's gate (shexp_gate_dot_256), then the tail of k_shexp_gate_tail. Same values as the four ops.
+static __global__ void __launch_bounds__(256) k_shexp_gate_dot_tail(const float * gw, const float * gy, const int ncols2,
+        const int64_t sy1, const float * shexp, const float * moe, float * dst, const int64_t ne0,
+        const int64_t ss1, const int64_t sm1, const int64_t sd1) {
+    __shared__ float buf[WARP_SIZE];
+    const int64_t i1 = blockIdx.y;
+    const float   g  = shexp_gate_dot_256(gw, gy + i1*sy1, ncols2, buf);
+    {
+#pragma clang fp contract(off)
+        const int64_t i0 = (int64_t) blockDim.x*blockIdx.x + threadIdx.x;
+        if (i0 >= ne0) {
+            return;
+        }
+        const float sig = op_sigmoid(g);
+        const float m   = shexp[i1*ss1 + i0] * sig;
+        dst[i1*sd1 + i0] = moe[i1*sm1 + i0] + m;
+    }
+}
+
+void ggml_cuda_op_shexp_gate_dot_tail(ggml_backend_cuda_context & ctx, const ggml_tensor * gw, const ggml_tensor * gy,
+        const ggml_tensor * shexp, const ggml_tensor * moe, ggml_tensor * dst) {
+    const int64_t ne0 = dst->ne[0];
+    const int64_t ne1 = dst->ne[1];
+    GGML_ASSERT(gw->ne[0] % 2 == 0 && gy->ne[1] == ne1);
+    const dim3 grid((ne0 + 255)/256, ne1, 1);
+    k_shexp_gate_dot_tail<<<grid, 256, 0, ctx.stream()>>>((const float *) gw->data, (const float *) gy->data, gw->ne[0]/2,
+        gy->nb[1]/sizeof(float), (const float *) shexp->data, (const float *) moe->data, (float *) dst->data, ne0,
+        shexp->nb[1]/sizeof(float), moe->nb[1]/sizeof(float), dst->nb[1]/sizeof(float));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+/* engine2n: GDN gates, ADD(alpha, dt_bias) -> SOFTPLUS -> MUL(., A) and SIGMOID(beta) in one kernel, with the values of the
+   separate ops (op_softplus / op_sigmoid as in the unaries, each binary result rounded on its own). x: head, y: token. */
+static __global__ void k_gdn_gates(const float * alpha, const float * bias, const float * A, float * gate,
+        const float * beta, float * beta_out, const int64_t nh,
+        const int64_t sa1, const int64_t sg1, const int64_t sb1, const int64_t sb2, const int64_t so1, const int64_t so2) {
+#pragma clang fp contract(off)
+    const int64_t j = (int64_t) blockDim.x*blockIdx.x + threadIdx.x;
+    const int64_t t = blockIdx.y;
+    if (j >= nh) {
+        return;
+    }
+    const float x = alpha[t*sa1 + j] + bias[j];
+    gate[t*sg1 + j] = op_softplus(x) * A[j];
+    beta_out[t*so2 + j*so1] = op_sigmoid(beta[t*sb2 + j*sb1]);
+}
+
+void ggml_cuda_op_gdn_gates(ggml_backend_cuda_context & ctx, const ggml_tensor * alpha, const ggml_tensor * bias, const ggml_tensor * A,
+        ggml_tensor * gate, const ggml_tensor * beta, ggml_tensor * beta_out) {
+    const int64_t nh = gate->ne[0];
+    const int64_t nt = gate->ne[1];
+    const dim3 grid((nh + 63)/64, nt, 1);
+    k_gdn_gates<<<grid, 64, 0, ctx.stream()>>>((const float *) alpha->data, (const float *) bias->data, (const float *) A->data,
+        (float *) gate->data, (const float *) beta->data, (float *) beta_out->data, nh,
+        alpha->nb[1]/sizeof(float), gate->nb[1]/sizeof(float), beta->nb[1]/sizeof(float), beta->nb[2]/sizeof(float),
+        beta_out->nb[1]/sizeof(float), beta_out->nb[2]/sizeof(float));
+}
+
+/* engine2n: attention output gate, CONT(gate view) -> SIGMOID -> MUL(attn, .), in one kernel that also writes the q8_1 copy for the
+   output projection: element i = op_sigmoid(gate[i]) * attn[i] as unary_gated_op_kernel computes it (the gate read straight from
+   the strided view the CONT would copy), and each warp quantizes its 32 results with quantize_q8_1's code. Same values. */
+static __global__ void k_gate_sigmoid_mul_q8(const char * gsrc, const int64_t gne0, const int64_t gne1, const uint64_t gnb0,
+        const uint64_t gnb1, const uint64_t gnb2, const float * x, float * dst, const int64_t k, block_q8_1 * q8) {
+    const int64_t i = (int64_t) blockDim.x*blockIdx.x + threadIdx.x;
+    float y = 0.0f;
+    if (i < k) {
+        const int64_t i0 = i % gne0;
+        const int64_t i1 = (i / gne0) % gne1;
+        const int64_t i2 = i / (gne0*gne1);
+        const float g = *(const float *) (gsrc + i0*gnb0 + i1*gnb1 + i2*gnb2);
+        y = op_sigmoid(g) * x[i];
+        dst[i] = y;
+    }
+    if (q8 != nullptr) {
+        float amax = fabsf(y);
+        float sum  = y;
+        amax = warp_reduce_max<QK8_1>(amax);
+        sum  = warp_reduce_sum<QK8_1>(sum);
+        const float  d = amax / 127.0f;
+        const int8_t q = amax == 0.0f ? 0 : roundf(y / d);
+        if (i < k) {
+            q8[i / QK8_1].qs[i % QK8_1] = q;
+            if (i % QK8_1 == 0) {
+                q8[i / QK8_1].ds = make_half2(d, sum);
+            }
+        }
+    }
