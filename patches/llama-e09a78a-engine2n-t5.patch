+// engine2n: SCALE -> SILU -> MUL_MAT(quantized weight, src1 = the SILU) — the hc lo path before hc up. One kernel computes
+// silu(scale*x + bias) with the arithmetic of scale_f32 and the SILU unary, writes it, and also writes its q8_1 copy the way
+// quantize_q8_1 does (same 32-value warp groups and reductions); the copy goes to a q8_1 cache slot so the matvec does not
+// quantize again. 3 kernels -> 1, same values. GGML_CUDA_NO_SCALE_SILU_Q8=1 turns it off.
+static __global__ void k_scale_silu_q8_1(const float * x, float * y, block_q8_1 * q, const int64_t ne0, const int64_t ne0_padded,
+        const int64_t sx1, const int64_t sy1, const float scale, const float bias) {
+    const int64_t i0 = (int64_t) blockDim.x*blockIdx.x + threadIdx.x;
+    if (i0 >= ne0_padded) {
+        return;
+    }
+    const int64_t i1 = blockIdx.y;
+    float v = 0.0f;
+    if (i0 < ne0) {
+        const float t = scale * x[i1*sx1 + i0] + bias;
+        v = ggml_cuda_op_silu_single(t);
+        y[i1*sy1 + i0] = v;
+    }
+    float amax = fabsf(v);
+    float sum  = v;
+    amax = warp_reduce_max<QK8_1>(amax);
+    sum  = warp_reduce_sum<QK8_1>(sum);
+    const float  d  = amax / 127.0f;
+    const int8_t qv = amax == 0.0f ? 0 : roundf(v / d);
+    const int64_t i_cont = i1*ne0_padded + i0;
+    q[i_cont / QK8_1].qs[i_cont % QK8_1] = qv;
+    if (i_cont % QK8_1 == 0) {
+        q[i_cont / QK8_1].ds = make_half2(d, sum);
+    }
+}
