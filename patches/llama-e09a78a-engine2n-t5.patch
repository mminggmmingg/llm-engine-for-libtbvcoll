+static void ggml_cuda_q8_1_cache_note_range(ggml_backend_cuda_context & ctx, const char * lo, const char * hi) {
+    for (auto & e : ctx.q8_1_cache.slots) {
+        if (e.used && lo < e.hi && e.lo < hi) {
+            e.used = false;
+        }
+    }
+}
