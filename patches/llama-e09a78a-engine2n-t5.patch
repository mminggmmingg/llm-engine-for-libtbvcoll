+    float bias;
+    memcpy(&scale, (const float *) sc->op_params + 0, sizeof(float));
+    memcpy(&bias,  (const float *) sc->op_params + 1, sizeof(float));
+    const int slot = qc.next;
+    block_q8_1 * q = (block_q8_1 *) ((char *) qc.buf + slot*qc.slot_size);
