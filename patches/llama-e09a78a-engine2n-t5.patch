+    float eps, scale_out;
+    memcpy(&eps, rms_a->op_params, sizeof(float));
+    memcpy(&scale_out, sc_a->op_params, sizeof(float));
+    const int nrows_a = (int) xa->ne[1];
+    const int nrows_b = (int) cgraph->nodes[r + n - 1]->src[0]->ne[1];
+    if ((off_a / (int64_t) (128*sizeof(float))) + nrows_a + nrows_b > silu->ne[0] / 128) {
+        return 0;
+    }
+    p.conv = conv; p.silu = silu; p.rms_a = rms_a; p.rms_b = cgraph->nodes[r + n - 1]; p.sc_a = sc_a; p.sc_b = sc_b;
+    p.head0 = (int) (off_a / (int64_t) (128*sizeof(float))); p.nrows_a = nrows_a; p.nrows_b = nrows_b;
+    p.eps = eps; p.scale_out = scale_out;
+    return r + n - i;
+}
+
+static int ggml_cuda_try_ssm_conv_norm_pair(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    ggml_cuda_conv_norm_pair_args p;
+    const int nskip = ggml_cuda_ssm_conv_norm_pair_match(cgraph, i, p);
+    if (nskip == 0) {
+        return 0;
+    }
+    ggml_tensor * conv = p.conv;
+    ggml_tensor * silu = p.silu;
+    ggml_tensor * rms_a = p.rms_a;
+    ggml_tensor * sc_a = p.sc_a;
+    ggml_tensor * sc_b = p.sc_b;
+    const int nrows_a = p.nrows_a, nrows_b = p.nrows_b;
+    const int64_t off_a = (int64_t) p.head0*128*sizeof(float);
+    ggml_cuda_op_ssm_conv_silu_norm_pair(ctx, conv, silu, p.head0, nrows_a, nrows_b, sc_a, sc_b, p.eps, p.scale_out);
+
+    static const bool verify = getenv("GGML_CUDA_CONV_NORM_VERIFY") != nullptr;
+    if (verify) {
+        const ggml_tensor * outs[3] = { silu, sc_a, sc_b };
+        std::vector<char> a[3], b[3];
+        for (int k = 0; k < 3; k++) {
+            a[k].resize(ggml_nbytes(outs[k]));
+            b[k].resize(ggml_nbytes(outs[k]));
+            CUDA_CHECK(cudaMemcpyAsync(a[k].data(), outs[k]->data, a[k].size(), cudaMemcpyDeviceToHost, ctx.stream()));
+        }
+        ggml_cuda_op_ssm_conv(ctx, conv, nullptr, silu);
+        ggml_cuda_op_rms_norm_scale_pair(ctx, rms_a, sc_a, p.rms_b, sc_b);
+        for (int k = 0; k < 3; k++) {
+            CUDA_CHECK(cudaMemcpyAsync(b[k].data(), outs[k]->data, b[k].size(), cudaMemcpyDeviceToHost, ctx.stream()));
+        }
+        CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+        const bool same = a[0] == b[0] && a[1] == b[1] && a[2] == b[2];
+        static int nprint = 0;
+        if (!same || nprint < 8) {
+            nprint++;
+            fprintf(stderr, "conv norm verify: %s head0 %lld rows %d+%d: %s (silu %d q %d k %d)\n", silu->name,
+                (long long) (off_a / (int64_t) (128*sizeof(float))), nrows_a, nrows_b, same ? "same" : "DIFFER", a[0] == b[0], a[1] == b[1],
+                a[2] == b[2]);
+        }
+    }
+    return nskip;
+}
+
+// engine2n: DSV4_HC_PRE whose output is the input of a quantized matmul within the next few nodes (attention qkv, MoE gate/up):
+// the hc_pre kernel also writes the q8_1 copy (dsv4-hc.cu). GGML_CUDA_NO_HC_PRE_Q8=1 turns it off.
+static void * ggml_cuda_hc_pre_q8_slot(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool off = getenv("GGML_CUDA_NO_HC_PRE_Q8") != nullptr;
+    const ggml_tensor * pre = cgraph->nodes[i];
+    if (off || !ctx.q8_1_cache.live || pre->ne[0] % QK8_1 != 0) {
+        return nullptr;
+    }
+    for (int j = i + 1; j < cgraph->n_nodes && j <= i + 32; j++) {
+        if (ggml_cuda_q8_1_input_of(ctx, cgraph->nodes[j], pre)) {
+            return ggml_cuda_q8_1_cache_reserve(ctx, cgraph->nodes[j]->src[1]);
+        }
+    }
+    return nullptr;
+}
+
+// engine2n: gated delta net conv state update CONCAT(state, x^T) -> VIEW(last W columns) -> CONT -> VIEW(cache) -> CPY: the
+// concat kernel also writes those columns into the cache, so the strided copy and the cache copy go (two kernels per layer).
+// k0, W: the cached columns, tail: where they go. GGML_CUDA_NO_CONV_STATE_FUSE=1 turns it off.
+static bool ggml_cuda_conv_state_tail_match(const ggml_cgraph * cgraph, int i, int64_t & k0, int64_t & W, float *& tail) {
+    static const bool off = getenv("GGML_CUDA_NO_CONV_STATE_FUSE") != nullptr;
+    if (off || i + 4 >= cgraph->n_nodes) {
+        return false;
+    }
+    const ggml_tensor * cat = cgraph->nodes[i];
+    const ggml_tensor * vw  = cgraph->nodes[i + 1];
+    const ggml_tensor * ct  = cgraph->nodes[i + 2];
+    const ggml_tensor * dv  = cgraph->nodes[i + 3];
+    const ggml_tensor * cp  = cgraph->nodes[i + 4];
+    if (cat->op != GGML_OP_CONCAT || ((const int32_t *) cat->op_params)[0] != 0 || cat->type != GGML_TYPE_F32 ||
+            cat->src[0]->type != GGML_TYPE_F32 || cat->src[1]->type != GGML_TYPE_F32 || cat->ne[2] != 1 || cat->ne[3] != 1 ||
+            vw->op != GGML_OP_VIEW || vw->src[0] != cat || vw->ne[1] != cat->ne[1] || vw->ne[2] != 1 || vw->ne[3] != 1 ||
+            vw->nb[0] != cat->nb[0] || vw->nb[1] != cat->nb[1] || vw->view_offs % cat->nb[0] != 0 ||
+            ct->op != GGML_OP_CONT || ct->src[0] != vw || ct->type != GGML_TYPE_F32 || !ggml_is_contiguous(ct) ||
+            cp->op != GGML_OP_CPY || cp->src[0] != ct || cp->src[1] != dv || dv->type != GGML_TYPE_F32 || !ggml_is_contiguous(dv) ||
+            ggml_nelements(dv) != ggml_nelements(ct) || cp->data != dv->data) {
+        return false;
+    }
+    k0 = vw->view_offs / cat->nb[0];
+    W  = vw->ne[0];
+    if (k0 + vw->ne[0] > cat->ne[0] || (ct->flags & GGML_TENSOR_FLAG_OUTPUT) || (vw->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+            (cat->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || (ct->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 ||
+            (cp->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || ggml_node_get_use_count(cgraph, i + 1) != 1 ||
+            !ggml_node_has_n_uses(cgraph, i + 2, 1)) {
+        return false;
+    }
+    tail = (float *) dv->data;
+    return true;
+}
+
+// engine2n: conv state read straight from the cache, as ggml_cuda_gdn_direct_gather does for the delta net state: the concat's
+// state input is a one-row get_rows of the cache whose only non-empty reader is that input (views/reshapes at offset 0, used once
+// each), so the concat kernel reads cache row ids[0] itself and the get_rows is not run. Nothing in between may write the cache,
+// and the tail must be a whole cache row or outside the cache, so that each channel's old state and new tail line up.
+// Returns the get_rows node index, or -1. GGML_CUDA_NO_CONV_DIRECT=1 turns it off.
+static int ggml_cuda_conv_direct_gather(const ggml_cgraph * cgraph, int cat_idx, const float * tail, int64_t W) {
+    static const bool off = getenv("GGML_CUDA_NO_CONV_DIRECT") != nullptr;
+    constexpr int window = 32;  // get_rows .. concat distance (9 nodes in qwen4exp)
+    const ggml_tensor * s0 = cgraph->nodes[cat_idx]->src[0];
+    if (off || !ggml_is_contiguous(s0) || s0->ne[0] != W) {
+        return -1;
+    }
+    const ggml_tensor * gr = s0;
+    while (gr != nullptr && (gr->op == GGML_OP_RESHAPE || gr->op == GGML_OP_VIEW)) {
+        if (gr->view_offs != 0) {
+            return -1;
+        }
+        gr = gr->src[0];
+    }
+    if (gr == nullptr || gr->op != GGML_OP_GET_ROWS || gr->type != GGML_TYPE_F32 || gr->ne[1] != 1 || gr->ne[2] != 1 ||
+            gr->ne[3] != 1 || (gr->flags & GGML_TENSOR_FLAG_OUTPUT) || ggml_nelements(s0) != gr->ne[0]) {
+        return -1;
+    }
+    const ggml_tensor * states = gr->src[0];
+    const ggml_tensor * ids    = gr->src[1];
+    if (states->type != GGML_TYPE_F32 || states->nb[0] != sizeof(float) || states->ne[0] != gr->ne[0] ||
+            states->nb[1] != gr->ne[0]*sizeof(float) || ids->type != GGML_TYPE_I32 || ids->ne[0] != 1 || states->data == nullptr ||
+            ids->data == nullptr) {
+        return -1;
+    }
+    const char * sb  = (const char *) states->data;
+    const char * tb  = (const char *) tail;
+    const size_t row = states->nb[1];
+    if (!(tb + row <= sb || tb >= sb + ggml_nbytes(states)) && (tb - sb) % row != 0) {
+        return -1;
+    }
+    int gr_idx = -1;
+    for (int j = cat_idx - 1; j >= 0 && j >= cat_idx - window; --j) {
+        if (cgraph->nodes[j] == gr) {
+            gr_idx = j;
+            break;
+        }
+    }
+    if (gr_idx < 0) {
+        return -1;
+    }
+    int uses = 0;
+    for (int j = gr_idx + 1; j < cat_idx; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        bool on_chain = false;
+        for (const ggml_tensor * t = s0; t != gr; t = t->src[0]) {
+            on_chain = on_chain || t == n;
+        }
+        if (on_chain && ggml_node_get_use_count(cgraph, j) != 1) {
+            return -1;
+        }
+        bool reads = false;
+        for (int k = 0; k < GGML_MAX_SRC; ++k) {
+            reads = reads || n->src[k] == gr;
+        }
+        if (reads) {
+            uses++;
+            if ((n->op != GGML_OP_VIEW && n->op != GGML_OP_RESHAPE) || (ggml_nelements(n) != 0 && !on_chain)) {
+                return -1;
+            }
+        }
+        if (!ggml_cuda_is_view_or_noop(n) && ggml_cuda_tensors_overlap(n, states)) {
+            return -1;
+        }
+    }
+    if (uses != ggml_node_get_use_count(cgraph, gr_idx)) {
+        return -1;
+    }
+    return gr_idx;
+}
+
+// a get_rows whose only reader is a fused conv state concat that reads the cache row itself: not launched
+static bool ggml_cuda_conv_gather_elided(const ggml_cgraph * cgraph, int gr_idx) {
+    const ggml_tensor * gr = cgraph->nodes[gr_idx];
+    if (gr->op != GGML_OP_GET_ROWS || gr->ne[1] != 1 || ggml_cuda_fusion_disabled()) {
+        return false;
+    }
+    for (int j = gr_idx + 1; j < cgraph->n_nodes && j <= gr_idx + 32; ++j) {
+        int64_t k0, W;
+        float * tail;
+        if (cgraph->nodes[j]->op == GGML_OP_CONCAT && ggml_cuda_conv_state_tail_match(cgraph, j, k0, W, tail) &&
+                ggml_cuda_conv_direct_gather(cgraph, j, tail, W) == gr_idx) {
+            static bool logged = false;
+            if (!logged) {
+                logged = true;
+                GGML_LOG_INFO("%s: the conv state concat reads its state from the cache (%s), the gather is skipped\n", __func__, gr->name);
+            }
+            return true;
+        }
+    }
+    return false;
+}
+
+// engine2n: the conv state concat group above (with the state read from the cache) and the one-token SSM_CONV -> SILU -> q/k norm
+// group in one kernel (ssm-conv.cu ssm_conv_silu_norm_pair_f32 direct, same values): the conv kernel makes the concat row itself,
+// stores it and the new state as the concat kernel would. Only views, empty nodes and gathers that are not run lie between the two
+// groups, so the conv group runs here and is skipped when the loop reaches it (conv_ahead). Not when an output of the conv group lies
+// over the concat output or the token's values (blocks write them while others read). GGML_CUDA_NO_CONV_CONCAT=1 turns it off.
+static int ggml_cuda_try_conv_concat_norm(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool off = getenv("GGML_CUDA_NO_CONV_CONCAT") != nullptr;
+    int64_t k0, W;
+    float * tail;
+    if (off || !ggml_cuda_conv_state_tail_match(cgraph, i, k0, W, tail)) {
+        return 0;
+    }
+    const int gr_idx = ggml_cuda_conv_direct_gather(cgraph, i, tail, W);
+    if (gr_idx < 0) {
+        return 0;
+    }
+    ggml_tensor * cat = cgraph->nodes[i];
+    int j = i + 5;
+    while (j < cgraph->n_nodes && j < i + 24 && cgraph->nodes[j]->op != GGML_OP_SSM_CONV &&
+            (ggml_cuda_is_view_or_noop(cgraph->nodes[j]) || ggml_cuda_gdn_gather_elided(cgraph, j) || ggml_cuda_conv_gather_elided(cgraph, j))) {
+        j++;
+    }
+    if (j >= cgraph->n_nodes || cgraph->nodes[j]->op != GGML_OP_SSM_CONV || cgraph->nodes[j]->src[0] != cat) {
+        return 0;
+    }
+    ggml_cuda_conv_norm_pair_args p;
+    const int n = ggml_cuda_ssm_conv_norm_pair_match(cgraph, j, p);
+    if (n == 0) {
+        return 0;
+    }
+    const ggml_tensor * gr = cgraph->nodes[gr_idx];
+    const ggml_tensor * x1 = cat->src[1];
+    const ggml_tensor * outs[3] = { p.silu, p.sc_a, p.sc_b };
+    if (W != 3 || cat->ne[0] != W + 1 || cat->ne[1] != p.silu->ne[0] || !ggml_is_contiguous(cat) || x1->type != GGML_TYPE_F32 ||
+            x1->ne[0] != 1 || x1->ne[1] != cat->ne[1]) {
+        return 0;
+    }
+    for (const ggml_tensor * o : outs) {
+        if (ggml_cuda_tensors_overlap(o, cat) || ggml_cuda_tensors_overlap(o, x1)) {
+            return 0;
+        }
+    }
+    ssm_conv_direct_in din;
+    din.states     = (const char *) gr->src[0]->data;
+    din.ids        = (const int32_t *) gr->src[1]->data;
+    din.states_nb1 = gr->src[0]->nb[1];
+    din.x1         = (const char *) x1->data;
+    din.nb11       = x1->nb[1];
+    din.cat        = (float *) cat->data;
+    din.tail       = tail;
+    din.k0         = (int) k0;
+    ggml_cuda_op_ssm_conv_silu_norm_pair(ctx, p.conv, p.silu, p.head0, p.nrows_a, p.nrows_b, p.sc_a, p.sc_b, p.eps, p.scale_out, &din);
+    ctx.conv_ahead_node = cgraph->nodes[j];
+    ctx.conv_ahead_n    = n;
+    return 4;
+}
+
+static int ggml_cuda_try_conv_state_tail(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    int64_t k0, W;
+    float * tail;
+    if (!ggml_cuda_conv_state_tail_match(cgraph, i, k0, W, tail)) {
+        return 0;
+    }
+    const int gr_idx = ggml_cuda_conv_direct_gather(cgraph, i, tail, W);
+    if (gr_idx >= 0) {
+        const ggml_tensor * gr = cgraph->nodes[gr_idx];
+        ggml_cuda_op_concat_state_tail_direct(ctx, cgraph->nodes[i], gr->src[0], gr->src[1], tail, k0, W);
+    } else {
+        ggml_cuda_op_concat_state_tail(ctx, cgraph->nodes[i], tail, k0, W);
+    }
+    return 4;
+}
+
+// engine2n: shared expert gate tail SIGMOID(g) -> MUL(shexp, sigmoid) -> ADD(moe_out, gated) in one kernel (unary.cu), same
+// values as the three ops. GGML_CUDA_NO_SHEXP_GATE_FUSE=1 turns it off.
+static bool ggml_cuda_shexp_gate_tail_ok(const ggml_cgraph * cgraph, int i) {
+    if (i + 2 >= cgraph->n_nodes) {
+        return false;
+    }
+    const ggml_tensor * sg  = cgraph->nodes[i];
+    const ggml_tensor * mul = cgraph->nodes[i + 1];
+    const ggml_tensor * add = cgraph->nodes[i + 2];
+    if (sg->op != GGML_OP_UNARY || ggml_get_unary_op(sg) != GGML_UNARY_OP_SIGMOID || mul->op != GGML_OP_MUL || add->op != GGML_OP_ADD ||
+            mul->src[1] != sg || add->src[1] != mul) {
+        return false;
+    }
+    // the sigmoid and the product are used only inside (shapes differ, so not ggml_can_fuse)
+    for (int k = 0; k < 3; k++) {
+        if ((cgraph->nodes[i + k]->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || (k < 2 && !ggml_node_has_n_uses(cgraph, i + k, 1))) {
+            return false;
+        }
+    }
+    const ggml_tensor * g     = sg->src[0];
+    const ggml_tensor * shexp = mul->src[0];
+    const ggml_tensor * moe   = add->src[0];
+    const int64_t ne0 = add->ne[0];
+    const int64_t ne1 = add->ne[1];
+    if (g->type != GGML_TYPE_F32 || sg->type != GGML_TYPE_F32 || shexp->type != GGML_TYPE_F32 || moe->type != GGML_TYPE_F32 ||
+            add->type != GGML_TYPE_F32 || mul->type != GGML_TYPE_F32 ||
+            sg->ne[0] != 1 || sg->ne[1] != ne1 || g->ne[0] != 1 || g->ne[1] != ne1 ||
+            !ggml_are_same_shape(shexp, add) || !ggml_are_same_shape(moe, add) || !ggml_are_same_shape(mul, add) ||
+            add->ne[2] != 1 || add->ne[3] != 1 ||
+            shexp->nb[0] != sizeof(float) || moe->nb[0] != sizeof(float) || add->nb[0] != sizeof(float)) {
+        return false;
+    }
+    // the output may be in memory freed after the sigmoid or the product ran (see ggml_cuda_tensors_overlap)
+    if (ggml_cuda_tensors_overlap(add, g) || ggml_cuda_tensors_overlap_shifted(add, shexp) || ggml_cuda_tensors_overlap_shifted(add, moe)) {
+        return false;
+    }
+    return true;
+}
+
+static bool ggml_cuda_try_shexp_gate_tail(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool off = getenv("GGML_CUDA_NO_SHEXP_GATE_FUSE") != nullptr;
+    if (off || !ggml_cuda_shexp_gate_tail_ok(cgraph, i)) {
+        return false;
+    }
+    ggml_tensor * add = cgraph->nodes[i + 2];
+    ggml_cuda_op_shexp_gate_tail(ctx, cgraph->nodes[i]->src[0], add->src[1]->src[0], add->src[0], add);
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
+
+// engine2n: the gate matmul in front of the tail too, MUL_MAT(w [ncols, 1] f32, y) -> SIGMOID -> MUL -> ADD, when the matmul would
+// run as mul_mat_vec_f with block 256 (its dot is repeated exactly in each block). GGML_CUDA_NO_SHEXP_GATE_DOT=1 turns it off.
+static bool ggml_cuda_shexp_gate_dot_tail_ok(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool off = getenv("GGML_CUDA_NO_SHEXP_GATE_DOT") != nullptr || getenv("GGML_CUDA_NO_SHEXP_GATE_FUSE") != nullptr;
+    const ggml_tensor * mm = cgraph->nodes[i];
+    if (off || mm->op != GGML_OP_MUL_MAT || !ggml_cuda_shexp_gate_tail_ok(cgraph, i + 1) || cgraph->nodes[i + 1]->src[0] != mm ||
+            (mm->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || !ggml_node_has_n_uses(cgraph, i, 1)) {
+        return false;
+    }
+    const ggml_tensor * w = mm->src[0];
+    const ggml_tensor * y = mm->src[1];
+    const int64_t ncols = w->ne[0];
+    if (w->type != GGML_TYPE_F32 || y->type != GGML_TYPE_F32 || mm->type != GGML_TYPE_F32 || w->ne[1] != 1 || w->ne[2] != 1 ||
+            w->ne[3] != 1 || !ggml_is_contiguous(w) || y->ne[0] != ncols || y->ne[2] != 1 || y->ne[3] != 1 || y->nb[0] != sizeof(float) ||
+            y->nb[1] % (2*sizeof(float)) != 0 || mm->ne[1] != cgraph->nodes[i + 3]->ne[1] || ncols % 2 != 0 ||
+            ggml_cuda_tensors_overlap(cgraph->nodes[i + 3], y)) {
+        return false;
+    }
+    // the mul_mat route for this shape and mul_mat_vec_f's block size choice (ggml_cuda_mul_mat, launch_mul_mat_vec_f_cuda)
+    const int cc        = ggml_cuda_info().devices[ctx.device].cc;
+    const int warp_size = ggml_cuda_info().devices[ctx.device].warp_size;
+    if (warp_size != WARP_SIZE || !ggml_cuda_should_use_mmvf(w->type, cc, warp_size, w->ne, w->nb, y->ne[1]) ||
+            (GGML_CUDA_CC_IS_AMD(cc) && cc < GGML_CUDA_CC_RDNA1)) {
+        return false;
+    }
+    int64_t block_size_best = warp_size;
+    int64_t niter_best      = (ncols + 2*warp_size - 1) / (2*warp_size);
+    for (int64_t block_size = 2*warp_size; block_size <= 256; block_size += warp_size) {
+        const int64_t niter = (ncols + 2*block_size - 1) / (2*block_size);
+        if (niter < niter_best) {
+            niter_best      = niter;
+            block_size_best = block_size;
+        }
+    }
+    return block_size_best == 256;
+}
+
+static bool ggml_cuda_try_shexp_gate_dot_tail(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    if (!ggml_cuda_shexp_gate_dot_tail_ok(ctx, cgraph, i)) {
+        return false;
+    }
+    const ggml_tensor * mm = cgraph->nodes[i];
+    ggml_tensor * add = cgraph->nodes[i + 3];
+    ggml_cuda_op_shexp_gate_dot_tail(ctx, mm->src[0], mm->src[1], add->src[1]->src[0], add->src[0], add);
+    return true;
+}
+
+// engine2n: the most tokens the fusions that also take MTP verify batches handle (shared expert tail): 4, or 1 with
+// GGML_CUDA_FUSE_1TOK=1 (as before 11-05, for comparisons)
+static int64_t ggml_cuda_fuse_max_tokens() {
+    static const int64_t n = getenv("GGML_CUDA_FUSE_1TOK") != nullptr ? 1 : 4;
+    return n;
+}
+
+// engine2n: the ordinary path computes this matmul of up to ggml_cuda_fuse_max_tokens() columns with mul_mat_vec_q
+// (ggml_cuda_should_fuse_mul_mat_vec_q without its one-column rule)
+static bool ggml_cuda_mmvq_cols_ok(const ggml_tensor * mm) {
+    if (mm->ne[1] == 1) {
+        return ggml_cuda_should_fuse_mul_mat_vec_q(mm);
+    }
+    const ggml_tensor * src0 = mm->src[0];
+    const ggml_tensor * src1 = mm->src[1];
+    const bool bad_padding_clear = ggml_backend_buffer_get_usage(src0->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE &&
+                                   ggml_nbytes(src0) != ggml_backend_buffer_get_alloc_size(src0->buffer, src0) && src0->view_src;
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    return mm->op == GGML_OP_MUL_MAT && ggml_is_quantized(src0->type) && !bad_padding_clear && src1->type == GGML_TYPE_F32 &&
+           mm->type == GGML_TYPE_F32 && mm->ne[1] <= ggml_cuda_fuse_max_tokens() && src1->ne[1] <= MMVQ_MAX_BATCH_SIZE &&
+           cc > GGML_CUDA_CC_PASCAL;
+}
+
+// engine2n: the shared expert down projection of 1-4 tokens in front of that gate tail, MUL_MAT(down) -> MUL_MAT(gate) -> SIGMOID ->
+// MUL -> ADD in one kernel (mmvq.cu mul_mat_vec_q_shexp_tail, same values). GGML_CUDA_NO_SHEXP_DOWN_TAIL=1 turns it off;
+// GGML_CUDA_SHEXP_TAIL_VERIFY=1 (debug) also runs the two ordinary kernels and compares the results bit for bit.
+static bool ggml_cuda_try_shexp_down_tail(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool off = getenv("GGML_CUDA_NO_SHEXP_DOWN_TAIL") != nullptr;
+    ggml_tensor * down = cgraph->nodes[i];
+    if (off || i + 4 >= cgraph->n_nodes || !ggml_cuda_shexp_gate_dot_tail_ok(ctx, cgraph, i + 1)) {
+        return false;
+    }
+    const ggml_tensor * w = down->src[0];
+    const ggml_tensor * y = down->src[1];
+    ggml_tensor * add = cgraph->nodes[i + 4];
+    const int cc = ggml_cuda_info().devices[ctx.device].cc;
+    if (add->src[1]->src[0] != down || !ggml_node_has_n_uses(cgraph, i, 1) || (down->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 ||
+            !ggml_cuda_mmvq_warp_row_supported(w->type, cc) || !ggml_cuda_mmvq_cols_ok(down) || y->type != GGML_TYPE_F32 ||
+            down->ne[1] < 1 || down->ne[1] > ggml_cuda_fuse_max_tokens() || down->ne[2] != 1 || down->ne[3] != 1 || w->ne[2] != 1 || w->ne[3] != 1 || down->ne[0] % 32 != 0 ||
+            !ggml_is_contiguous(add)) {
+        return false;
+    }
+    const ggml_tensor * gate = cgraph->nodes[i + 1];
+    // every block reads the whole gate input (the gate dot) while the blocks write their rows of the output
+    if (ggml_cuda_tensors_overlap(add, gate->src[1]) || ggml_cuda_tensors_overlap(add, gate->src[0]) ||
+            ggml_cuda_tensors_overlap_shifted(add, add->src[0])) {
+        return false;
+    }
+    ggml_cuda_mm_fusion_args_host fusion{};
+    fusion.tail_out = add;
+    fusion.tail_gw  = gate->src[0];
+    fusion.tail_gy  = gate->src[1];
+    fusion.tail_moe = add->src[0];
+
+    static const bool verify = getenv("GGML_CUDA_SHEXP_TAIL_VERIFY") != nullptr;
+    if (!verify) {  // (the check below re-runs the tail on the saved routed output, so it keeps the add separate)
+        fusion.tail_comm = ggml_cuda_comm_take(ctx, add->src[0]);
+    } else {
+        ggml_cuda_comm_flush_if_touches(ctx, add);  // a held-back allreduce add of the routed output goes in first
+    }
+    const ggml_tensor * moe = add->src[0];
+    std::vector<float> moe0, a, b;
+    if (verify) {  // the output may be the routed input itself (in place): keep it for the second run
+        moe0.resize(ggml_nelements(moe));
+        CUDA_CHECK(cudaMemcpyAsync(moe0.data(), moe->data, ggml_nbytes(moe), cudaMemcpyDeviceToHost, ctx.stream()));
+        CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+    }
+    ggml_cuda_mul_mat_vec_q(ctx, w, y, nullptr, down, &fusion);
+    if (verify) {
+        a.resize(ggml_nelements(add));
+        b.resize(ggml_nelements(add));
+        CUDA_CHECK(cudaMemcpyAsync(a.data(), add->data, ggml_nbytes(add), cudaMemcpyDeviceToHost, ctx.stream()));
+        CUDA_CHECK(cudaMemcpyAsync(moe->data, moe0.data(), ggml_nbytes(moe), cudaMemcpyHostToDevice, ctx.stream()));
+        ggml_cuda_mul_mat_vec_q(ctx, w, y, nullptr, down);
+        ggml_cuda_op_shexp_gate_dot_tail(ctx, gate->src[0], gate->src[1], down, moe, add);
+        CUDA_CHECK(cudaMemcpyAsync(b.data(), add->data, ggml_nbytes(add), cudaMemcpyDeviceToHost, ctx.stream()));
+        CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+        int nbad = 0;
+        for (size_t k = 0; k < a.size(); k++) {
+            nbad += memcmp(&a[k], &b[k], sizeof(float)) != 0;
+        }
+        static int nprint[5] = {};  // per token count
+        const int64_t T = down->ne[1];
+        if (nbad || nprint[T] < 8) {
+            nprint[T]++;
+            fprintf(stderr, "shexp tail verify: %s tokens %lld: %d of %zu differ\n", add->name, (long long) T, nbad, a.size());
+        }
+    }
+    return true;
+}
+
+// engine2n: GDN gates — ADD(alpha, dt_bias) -> SOFTPLUS -> MUL(., A) [-> views] -> SIGMOID(beta) in one kernel (unary.cu),
+// same values. Returns the number of nodes to skip, 0 if it does not match. GGML_CUDA_NO_GDN_GATES_FUSE=1 turns it off.
+static int ggml_cuda_gdn_gates_match(ggml_cgraph * cgraph, int i) {
+    static const bool off = getenv("GGML_CUDA_NO_GDN_GATES_FUSE") != nullptr;
+    if (off || i + 2 >= cgraph->n_nodes) {
+        return 0;
+    }
+    ggml_tensor * add = cgraph->nodes[i];
+    ggml_tensor * sp  = cgraph->nodes[i + 1];
+    ggml_tensor * mul = cgraph->nodes[i + 2];
+    if (add->op != GGML_OP_ADD || sp->op != GGML_OP_UNARY || ggml_get_unary_op(sp) != GGML_UNARY_OP_SOFTPLUS ||
+            mul->op != GGML_OP_MUL || sp->src[0] != add || mul->src[0] != sp) {
+        return 0;
+    }
+    // the sigmoid of beta follows after view-only nodes
+    int k = i + 3;
+    while (k < cgraph->n_nodes && ggml_cuda_is_view_or_noop(cgraph->nodes[k])) {
+        k++;
+    }
+    if (k >= cgraph->n_nodes || k - i > 6) {
+        return 0;
+    }
+    ggml_tensor * sg = cgraph->nodes[k];
+    if (sg->op != GGML_OP_UNARY || ggml_get_unary_op(sg) != GGML_UNARY_OP_SIGMOID) {
+        return 0;
+    }
+    for (int n = i; n <= k; n++) {
+        if (!ggml_cuda_is_view_or_noop(cgraph->nodes[n]) && (cgraph->nodes[n]->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            return 0;
+        }
+    }
+    if (!ggml_node_has_n_uses(cgraph, i, 1) || !ggml_node_has_n_uses(cgraph, i + 1, 1)) {
+        return 0;
+    }
+    const ggml_tensor * alpha = add->src[0];
+    const ggml_tensor * bias  = add->src[1];
+    const ggml_tensor * A     = mul->src[1];
+    const ggml_tensor * beta  = sg->src[0];
+    const int64_t nh = mul->ne[0];
+    const int64_t nt = mul->ne[1];
+    const ggml_tensor * f32s[] = {alpha, bias, A, beta, add, sp, mul, sg};
+    for (const ggml_tensor * t : f32s) {
+        if (t->type != GGML_TYPE_F32 || t->nb[0] != sizeof(float)) {
+            return 0;
+        }
+    }
+    if (alpha->ne[0] != nh || alpha->ne[1] != nt || ggml_nelements(bias) != nh || ggml_nelements(A) != nh ||
+            mul->ne[2] != 1 || mul->ne[3] != 1 || !ggml_are_same_shape(add, mul) || !ggml_are_same_shape(sp, mul) ||
+            beta->ne[0] != 1 || beta->ne[1] != nh || beta->ne[2] != nt || beta->ne[3] != 1 || !ggml_are_same_shape(sg, beta) ||
+            !ggml_is_contiguous(bias) || !ggml_is_contiguous(A)) {
+        return 0;
+    }
+    return k - i;
+}
+
+static int ggml_cuda_try_gdn_gates(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    const int n = ggml_cuda_gdn_gates_match(cgraph, i);
+    if (n == 0) {
+        return 0;
+    }
+    ggml_tensor * add = cgraph->nodes[i];
+    ggml_tensor * mul = cgraph->nodes[i + 2];
+    ggml_tensor * sg  = cgraph->nodes[i + n];
+    ggml_cuda_op_gdn_gates(ctx, add->src[0], add->src[1], mul->src[1], mul, sg->src[0], sg);
+    CUDA_CHECK(cudaGetLastError());
+    return n;
+}
+
+// engine2n: the one-token beta/alpha matmul in front of the gates, MUL_MAT -> VIEW(alpha) -> ADD -> SOFTPLUS -> MUL ... VIEW(beta)
+// -> SIGMOID, when alpha and beta are views of the matmul result that nothing else reads: one kernel (mmvq.cu
+// mul_mat_vec_q_gdn_gates, same values). GGML_CUDA_NO_GDN_MM_GATES=1 turns it off; GGML_CUDA_GDN_GATES_VERIFY=1 (debug) also
+// runs the two ordinary kernels and compares the gates bit for bit.
+static int ggml_cuda_try_gdn_mm_gates(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool off = getenv("GGML_CUDA_NO_GDN_MM_GATES") != nullptr;
+    ggml_tensor * mm = cgraph->nodes[i];
+    if (off || mm->op != GGML_OP_MUL_MAT || (mm->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+        return 0;
+    }
+    int ia = i + 1;
+    while (ia < cgraph->n_nodes && ggml_cuda_is_view_or_noop(cgraph->nodes[ia])) {
+        ia++;
+    }
+    if (ia >= cgraph->n_nodes || ia - i > 3 || cgraph->nodes[ia]->op != GGML_OP_ADD) {
+        return 0;
+    }
+    const int n = ggml_cuda_gdn_gates_match(cgraph, ia);
+    if (n == 0) {
+        return 0;
+    }
+    ggml_tensor * add = cgraph->nodes[ia];
+    ggml_tensor * mul = cgraph->nodes[ia + 2];
+    ggml_tensor * sg  = cgraph->nodes[ia + n];
+    const ggml_tensor * alpha = add->src[0];
+    const ggml_tensor * beta  = sg->src[0];
+    const ggml_tensor * w     = mm->src[0];
+    const int cc = ggml_cuda_info().devices[ctx.device].cc;
+    if (alpha->op != GGML_OP_VIEW || alpha->src[0] != mm || beta->op != GGML_OP_VIEW || beta->src[0] != mm ||
+            !ggml_cuda_mmvq_warp_row_supported(w->type, cc) || !ggml_cuda_should_fuse_mul_mat_vec_q(mm) || mm->type != GGML_TYPE_F32 ||
+            mm->src[1]->type != GGML_TYPE_F32 || mm->ne[1] != 1 || mm->ne[2] != 1 || mm->ne[3] != 1 || w->ne[2] != 1 || w->ne[3] != 1 ||
+            mul->ne[1] != 1 || !ggml_is_contiguous(mul) || !ggml_node_has_n_uses(cgraph, i, 2)) {
+        return 0;
+    }
+    // (uses of a view count on its source: the 2 uses of the matmul result are the ADD and the SIGMOID)
+    const int64_t nh       = mul->ne[0];
+    const int64_t a_off    = ((const char *) alpha->data - (const char *) mm->data) / (int64_t) sizeof(float);
+    const int64_t b_off    = ((const char *) beta->data  - (const char *) mm->data) / (int64_t) sizeof(float);
+    const int64_t b_stride = beta->nb[1] / sizeof(float);
+    if (a_off < 0 || b_off < 0 || b_stride <= 0 || a_off + nh > mm->ne[0] || b_off + (nh - 1)*b_stride >= mm->ne[0] ||
+            (const char *) alpha->data != (const char *) mm->data + a_off*sizeof(float) ||
+            (const char *) beta->data  != (const char *) mm->data + b_off*sizeof(float) ||
+            ggml_cuda_tensors_overlap(mul, sg)) {
+        return 0;
+    }
+    ggml_cuda_mm_fusion_args_host fusion{};
+    fusion.gdn_gate        = (float *) mul->data;
+    fusion.gdn_beta        = (float *) sg->data;
+    fusion.gdn_bias        = (const float *) add->src[1]->data;
+    fusion.gdn_A           = (const float *) mul->src[1]->data;
+    fusion.gdn_nh          = (int) nh;
+    fusion.gdn_a_off       = (int) a_off;
+    fusion.gdn_b_off       = (int) b_off;
+    fusion.gdn_b_stride    = (int) b_stride;
+    fusion.gdn_beta_stride = (int) (sg->nb[1] / sizeof(float));
+    ggml_cuda_mul_mat_vec_q(ctx, w, mm->src[1], nullptr, mm, &fusion);
+
+    static const bool verify = getenv("GGML_CUDA_GDN_GATES_VERIFY") != nullptr;
+    if (verify) {
+        std::vector<float> g0(ggml_nelements(mul)), b0(ggml_nelements(sg)), g1(g0.size()), b1(b0.size());
+        CUDA_CHECK(cudaMemcpyAsync(g0.data(), mul->data, ggml_nbytes(mul), cudaMemcpyDeviceToHost, ctx.stream()));
+        CUDA_CHECK(cudaMemcpyAsync(b0.data(), sg->data, ggml_nbytes(sg), cudaMemcpyDeviceToHost, ctx.stream()));
+        ggml_cuda_mul_mat_vec_q(ctx, w, mm->src[1], nullptr, mm);
+        ggml_cuda_op_gdn_gates(ctx, alpha, add->src[1], mul->src[1], mul, beta, sg);
+        CUDA_CHECK(cudaMemcpyAsync(g1.data(), mul->data, ggml_nbytes(mul), cudaMemcpyDeviceToHost, ctx.stream()));
+        CUDA_CHECK(cudaMemcpyAsync(b1.data(), sg->data, ggml_nbytes(sg), cudaMemcpyDeviceToHost, ctx.stream()));
+        CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+        const int nbad = memcmp(g0.data(), g1.data(), g0.size()*sizeof(float)) != 0 || memcmp(b0.data(), b1.data(), b0.size()*sizeof(float)) != 0;
+        static int nprint = 0;
+        if (nbad || nprint < 8) {
+            nprint++;
+            fprintf(stderr, "gdn gates verify: %s nh %lld a_off %lld b_off %lld b_stride %lld: %s\n", mul->name, (long long) nh,
+                (long long) a_off, (long long) b_off, (long long) b_stride, nbad ? "DIFFER" : "same");
+        }
+    }
+    return ia + n - i;
+}
+
+// engine2n: the attention output gate CONT(gate view) -> SIGMOID -> MUL(attn, sigmoid) in one kernel that also writes the q8_1 copy
+// for the output projection (unary.cu k_gate_sigmoid_mul_q8, same values). Returns the nodes to skip, 0 if it does not match.
+// GGML_CUDA_NO_ATTN_GATE_Q8=1 turns it off.
+static int ggml_cuda_try_gate_sigmoid_mul_q8(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool off = getenv("GGML_CUDA_NO_ATTN_GATE_Q8") != nullptr;
+    if (off || i + 2 >= cgraph->n_nodes) {
+        return 0;
+    }
+    ggml_tensor * cont = cgraph->nodes[i];
+    ggml_tensor * sg   = cgraph->nodes[i + 1];
+    ggml_tensor * mul  = cgraph->nodes[i + 2];
+    if (cont->op != GGML_OP_CONT || sg->op != GGML_OP_UNARY || ggml_get_unary_op(sg) != GGML_UNARY_OP_SIGMOID || sg->src[0] != cont ||
+            mul->op != GGML_OP_MUL || (mul->src[0] != sg && mul->src[1] != sg)) {
+        return 0;
+    }
+    const ggml_tensor * gv = cont->src[0];
+    const ggml_tensor * x  = mul->src[0] == sg ? mul->src[1] : mul->src[0];
+    const int64_t k = ggml_nelements(mul);
+    if (cont->type != GGML_TYPE_F32 || gv->type != GGML_TYPE_F32 || sg->type != GGML_TYPE_F32 || mul->type != GGML_TYPE_F32 ||
+            x->type != GGML_TYPE_F32 || gv->nb[0] != sizeof(float) || gv->ne[3] != 1 || ggml_nelements(cont) != k ||
+            ggml_nelements(sg) != k || ggml_nelements(x) != k || !ggml_is_contiguous(cont) || !ggml_is_contiguous(sg) ||
+            !ggml_is_contiguous(x) || !ggml_is_contiguous(mul) || !ggml_are_same_shape(sg, x) || k % QK8_1 != 0 ||
+            (cont->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || (sg->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 ||
+            (mul->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || !ggml_node_has_n_uses(cgraph, i, 1) || !ggml_node_has_n_uses(cgraph, i + 1, 1) ||
+            ggml_cuda_tensors_overlap(mul, gv) || ggml_cuda_tensors_overlap_shifted(mul, x)) {
+        return 0;
+    }
+    void * q8 = nullptr;
+    int m = i + 3;
+    while (m < cgraph->n_nodes && ggml_cuda_is_view_or_noop(cgraph->nodes[m])) {
+        m++;
+    }
+    if (ctx.q8_1_cache.live && m < cgraph->n_nodes && cgraph->nodes[m]->op == GGML_OP_MUL_MAT &&
+            ggml_cuda_q8_1_input_of(ctx, cgraph->nodes[m], mul)) {
+        q8 = ggml_cuda_q8_1_cache_reserve(ctx, cgraph->nodes[m]->src[1]);
+    }
+    ggml_cuda_op_gate_sigmoid_mul_q8(ctx, gv, x, mul, q8);
+    return 2;
+}
+
+// engine2n: RMS_NORM -> MUL -> ROPE (multi/imrope) [-> VIEW -> SET_ROWS] in one kernel (rope.cu rms_norm_mul_rope_multi_f32, same
+// values as the separate norm and rope kernels): the attention q/k norms and the indexer's. Returns the nodes to skip, 0 if it does
+// not match. GGML_CUDA_NO_NORM_ROPE=1 turns it off; GGML_CUDA_NORM_ROPE_VERIFY=1 (debug) also runs the separate kernels and
+// compares the output (for SET_ROWS the whole cache view) bit for bit.
+static int ggml_cuda_try_rms_norm_mul_rope_multi(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool off = getenv("GGML_CUDA_NO_NORM_ROPE") != nullptr;
+    if (off || i + 2 >= cgraph->n_nodes || !ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL }, {})) {
+        return 0;
+    }
+    ggml_tensor * rms  = cgraph->nodes[i];
+    ggml_tensor * mul  = cgraph->nodes[i + 1];
+    ggml_tensor * rope = cgraph->nodes[i + 2];
+    if (rope->op != GGML_OP_ROPE || rope->src[0] != mul || (rope->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 ||
+            !ggml_node_has_n_uses(cgraph, i + 1, 1) || rope->src[0]->ne[3] != 1) {
+        return 0;
+    }
+    ggml_tensor * set_rows = nullptr;
+    if (i + 4 < cgraph->n_nodes && ggml_cuda_can_fuse(cgraph, i + 2, { GGML_OP_ROPE, GGML_OP_VIEW, GGML_OP_SET_ROWS }, {}) &&
+            ggml_cuda_should_fuse_rope_set_rows(rope, cgraph->nodes[i + 3], cgraph->nodes[i + 4])) {
+        set_rows = cgraph->nodes[i + 4];
+    }
+    const ggml_tensor * out = set_rows ? set_rows : rope;
+    if (ggml_cuda_tensors_overlap(out, rms->src[0])) {
+        return 0;
+    }
+    static const bool verify = getenv("GGML_CUDA_NORM_ROPE_VERIFY") != nullptr;
+    std::vector<char> a, b;
+    if (!ggml_cuda_op_rms_norm_mul_rope_multi(ctx, rms, mul, rope, set_rows)) {
+        return 0;
+    }
+    if (verify) {
+        a.resize(ggml_nbytes(out));
+        b.resize(ggml_nbytes(out));
+        CUDA_CHECK(cudaMemcpyAsync(a.data(), out->data, a.size(), cudaMemcpyDeviceToHost, ctx.stream()));
+        ggml_cuda_op_rms_norm_fused(ctx, rms, mul);
+        if (set_rows) {
+            ggml_cuda_op_rope_fused(ctx, rope, set_rows);
+        } else {
+            ggml_cuda_op_rope(ctx, rope);
+        }
+        CUDA_CHECK(cudaMemcpyAsync(b.data(), out->data, b.size(), cudaMemcpyDeviceToHost, ctx.stream()));
+        CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+        static int nprint = 0;
+        if (a != b || nprint < 12) {
+            nprint++;
+            fprintf(stderr, "norm rope verify: %s%s: %s\n", rope->name, set_rows ? " (set_rows)" : "", a == b ? "same" : "DIFFER");
+        }
+    }
+    return set_rows ? 4 : 2;
+}
+
+// engine2n: the compressed indexer key chain of one token, FILL -> CONCAT -> SET_ROWS -> GET_ROWS -> CONT -> ADD... -> SCALE -> RMS_NORM
+// -> MUL -> ROPE -> SET_ROWS (views between), in one kernel (rope.cu idx_k_pool_f32, same values). Only the cache rows and the rope
+// result are written; every other result must have no reader outside the chain. Returns the nodes to skip, 0 if it does not
+// match. GGML_CUDA_NO_IDX_K_POOL=1 turns it off; GGML_CUDA_IDX_K_POOL_VERIFY=1 (debug) also runs the separate ops and compares the
+// two cache rows and the rope result bit for bit.
+static int ggml_cuda_try_idx_k_pool(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool off = getenv("GGML_CUDA_NO_IDX_K_POOL") != nullptr;
+    constexpr int D = 128;
+    if (off || cgraph->nodes[i]->op != GGML_OP_FILL) {
+        return 0;
+    }
+    int ix[24];
+    int n = 0;
+    for (int k = i; k < cgraph->n_nodes && n < 24 && k < i + 48; k++) {
+        if (!ggml_cuda_is_view_or_noop(cgraph->nodes[k])) {
+            ix[n++] = k;
+        }
+    }
+    if (n < 4) {
+        return 0;
+    }
+    ggml_tensor * fill = cgraph->nodes[ix[0]];
+    ggml_tensor * cat  = cgraph->nodes[ix[1]];
+    ggml_tensor * set1 = cgraph->nodes[ix[2]];
+    ggml_tensor * gr   = cgraph->nodes[ix[3]];
+    const int np = gr->op == GGML_OP_GET_ROWS ? (int) gr->ne[1] : 0;
+    if (np < 1 || np > 8 || n < 12 + np) {
+        return 0;
+    }
+    ggml_tensor * cont = cgraph->nodes[ix[4]];
+    ggml_tensor * prev = cont;
+    for (int p = 1; p < np; p++) {
+        ggml_tensor * add = cgraph->nodes[ix[4 + p]];
+        if (add->op != GGML_OP_ADD || add->src[0] != prev || add->type != GGML_TYPE_F32 || add->ne[0] != D || !ggml_is_contiguous(add) ||
+                add->src[1]->data != (const char *) gr->data + (size_t) p*D*sizeof(float) || add->src[1]->ne[0] != D ||
+                ggml_nelements(add->src[1]) != D || !ggml_node_has_n_uses(cgraph, ix[4 + p], 1)) {
+            return 0;
+        }
+        prev = add;
+    }
+    ggml_tensor * sc   = cgraph->nodes[ix[4 + np]];
+    ggml_tensor * rms  = cgraph->nodes[ix[5 + np]];
+    ggml_tensor * mul  = cgraph->nodes[ix[6 + np]];
+    ggml_tensor * rope = cgraph->nodes[ix[7 + np]];
+    ggml_tensor * set2 = cgraph->nodes[ix[8 + np]];
+    const ggml_tensor * k = cat->src[0];
+    const ggml_tensor * w = mul->src[0] == rms ? mul->src[1] : mul->src[0];
+    if (fill->type != GGML_TYPE_F32 || fill->ne[0] != D || ggml_nelements(fill) != D ||
+            cat->op != GGML_OP_CONCAT || ((const int32_t *) cat->op_params)[0] != 0 || cat->type != GGML_TYPE_F32 || cat->src[1] != fill ||
+            k->type != GGML_TYPE_F32 || k->ne[0] != D || ggml_nelements(k) != D || !ggml_is_contiguous(k) || cat->ne[0] != 2*D ||
+            ggml_nelements(cat) != 2*D || !ggml_is_contiguous(cat) ||
+            set1->op != GGML_OP_SET_ROWS || set1->type != GGML_TYPE_F16 || set1->src[0]->data != cat->data || set1->src[0]->ne[0] != 2*D ||
+            ggml_nelements(set1->src[0]) != 2*D || set1->ne[0] != 2*D || set1->nb[0] != sizeof(half) || set1->src[1]->type != GGML_TYPE_I64 ||
+            ggml_nelements(set1->src[1]) != 1 ||
+            gr->src[0]->type != GGML_TYPE_F16 || gr->src[0]->data != set1->data || gr->src[0]->ne[0] != D || gr->src[0]->nb[1] != set1->nb[1] ||
+            gr->src[1]->type != GGML_TYPE_I32 || gr->src[1]->ne[0] != np || ggml_nelements(gr->src[1]) != np || gr->type != GGML_TYPE_F32 ||
+            !ggml_is_contiguous(gr) || gr->ne[0] != D ||
+            cont->op != GGML_OP_CONT || cont->src[0]->data != gr->data || ggml_nelements(cont) != D || cont->type != GGML_TYPE_F32 ||
+            sc->op != GGML_OP_SCALE || sc->src[0] != prev || ggml_nelements(sc) != D ||
+            rms->op != GGML_OP_RMS_NORM || rms->src[0] != sc || mul->op != GGML_OP_MUL || (mul->src[0] != rms && mul->src[1] != rms) ||
+            w->type != GGML_TYPE_F32 || ggml_nelements(w) != D || !ggml_is_contiguous(w) ||
+            rope->op != GGML_OP_ROPE || rope->src[0]->data != mul->data || rope->src[0]->ne[0] != D ||
+            set2->op != GGML_OP_SET_ROWS || set2->type != GGML_TYPE_F16 || set2->src[0]->data != rope->data || set2->src[0]->ne[0] != D ||
+            ggml_nelements(set2->src[0]) != D || set2->data != (const char *) set1->data + D*sizeof(half) || set2->nb[1] != set1->nb[1] ||
+            set2->src[1]->type != GGML_TYPE_I64 || ggml_nelements(set2->src[1]) != 1) {
+        return 0;
+    }
+    // the separate norm takes its float4 path with blocks of 32 (rms_norm_f32_dispatch), and nothing reads the results we skip
+    if (((uintptr_t) mul->data & 15) != 0 || ((uintptr_t) sc->data & 15) != 0 || ((uintptr_t) w->data & 15) != 0) {
+        return 0;
+    }
+    // (use counts do not see readers behind a reshape and its views, so look for them: any node after the chain reading one of the
+    // results we do not store, or a view of it, means no fusion)
+    const ggml_tensor * skipped[16];
+    int nskipped = 0;
+    for (int q = 0; q < 7 + np; q++) {
+        skipped[nskipped++] = cgraph->nodes[ix[q]];  // fill .. mul (the cache rows and the rope result are stored)
+    }
+    skipped[2] = fill;  // (ix[2] is the first SET_ROWS, whose result is the cache)
+    for (int q = ix[8 + np] + 1; q < cgraph->n_nodes; q++) {
+        const ggml_tensor * u = cgraph->nodes[q];
+        for (int j = 0; j < GGML_MAX_SRC; j++) {
+            const ggml_tensor * v = u->src[j];
+            if (v == nullptr) {
+                continue;
+            }
+            const ggml_tensor * root = v->view_src ? v->view_src : v;
+            for (int r = 0; r < nskipped; r++) {
+                if (root == skipped[r]) {
+                    return 0;
+                }
+            }
+        }
+    }
+    for (int q = 0; q < 9 + np; q++) {
+        if ((cgraph->nodes[ix[q]]->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            return 0;
+        }
+    }
+    idx_k_pool_host h;
+    h.k         = (const float *) k->data;
+    memcpy(&h.fill, fill->op_params, sizeof(float));
+    h.cache     = (char *) set1->data;
+    h.cache_nb1 = set1->nb[1];
+    h.row_new   = (const int64_t *) set1->src[1]->data;
+    h.pool_ids  = (const int32_t *) gr->src[1]->data;
+    h.npool     = np;
+    memcpy(&h.sc, (const float *) sc->op_params + 0, sizeof(float));
+    memcpy(&h.sb, (const float *) sc->op_params + 1, sizeof(float));
+    memcpy(&h.eps, rms->op_params, sizeof(float));
+    h.w         = (const float *) w->data;
+    h.row_pool  = (const int64_t *) set2->src[1]->data;
+    static const bool verify = getenv("GGML_CUDA_IDX_K_POOL_VERIFY") != nullptr;
+    std::vector<char> k0;
+    if (verify) {  // the rope result may be stored over k (the allocator reuses it): keep k for the second run
+        k0.resize(D*sizeof(float));
+        CUDA_CHECK(cudaMemcpyAsync(k0.data(), k->data, k0.size(), cudaMemcpyDeviceToHost, ctx.stream()));
+        CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+    }
+    if (!ggml_cuda_op_idx_k_pool(ctx, rope, h)) {
+        return 0;
+    }
+    if (verify) {
+        int64_t r_new = 0, r_pool = 0;
+        CUDA_CHECK(cudaMemcpyAsync(&r_new, h.row_new, sizeof(int64_t), cudaMemcpyDeviceToHost, ctx.stream()));
+        CUDA_CHECK(cudaMemcpyAsync(&r_pool, h.row_pool, sizeof(int64_t), cudaMemcpyDeviceToHost, ctx.stream()));
+        CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+        const size_t rb = 2*D*sizeof(half);
+        std::vector<char> a(2*rb + D*sizeof(float)), b(a.size());
+        auto grab = [&](std::vector<char> & v) {
+            CUDA_CHECK(cudaMemcpyAsync(v.data(), h.cache + r_new*h.cache_nb1, rb, cudaMemcpyDeviceToHost, ctx.stream()));
+            CUDA_CHECK(cudaMemcpyAsync(v.data() + rb, h.cache + r_pool*h.cache_nb1, rb, cudaMemcpyDeviceToHost, ctx.stream()));
+            CUDA_CHECK(cudaMemcpyAsync(v.data() + 2*rb, rope->data, D*sizeof(float), cudaMemcpyDeviceToHost, ctx.stream()));
+            CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+        };
+        grab(a);
+        CUDA_CHECK(cudaMemcpyAsync(k->data, k0.data(), k0.size(), cudaMemcpyHostToDevice, ctx.stream()));
+        for (int q = 0; q < 9 + np; q++) {
+            ggml_cuda_compute_forward(ctx, cgraph->nodes[ix[q]]);
+        }
+        grab(b);
+        static int nprint = 0;
+        if (a != b || nprint < 8) {
+            nprint++;
+            fprintf(stderr, "idx k pool verify: %s rows %lld/%lld np %d: %s\n", rope->name, (long long) r_new, (long long) r_pool, np,
+                a == b ? "same" : "DIFFER");
+        }
+    }
+    return ix[8 + np] - i;
+}
+
+// try and fuse nodes and return the number of nodes to skip
+// engine2n: the hc block's SCALE -> SILU -> MUL_MAT(hc up, Q8_0 weights, K <= 512) -> (views) -> DSV4_HC_PRE (gated, 1-4 tokens,
+// hc 4) in one kernel (dsv4-hc.cu k_hc_up_pre, same values). Returns the nodes it covers past i, or 0.
+// GGML_CUDA_NO_HC_UP_PRE=1 turns it off. One token by default: with more tokens one block's 32 warps each do 4 rows x T
+// columns and the kernel is slower than the three it replaces (11-05: MTP -2.7%); GGML_CUDA_HC_UP_PRE_NTOK=<2..4> takes more.
+// GGML_CUDA_HC_UP_PRE_VERIFY=1 (debug) also runs the ordinary nodes and compares bit for bit.
+// the hc block SCALE -> SILU -> MUL_MAT(hc up) [-> views] -> DSV4_HC_PRE at node i, over at most max_tokens: the index of the
+// DSV4_HC_PRE, or 0 if it does not match (ggml_cuda_try_hc_up_pre and the segment kernel share it)
+static int ggml_cuda_hc_up_pre_match(const ggml_cgraph * cgraph, int i, int64_t max_tokens) {
+    if (i + 3 >= cgraph->n_nodes) {
+        return 0;
+    }
+    const ggml_tensor * sc = cgraph->nodes[i];
+    const ggml_tensor * si = cgraph->nodes[i + 1];
+    const ggml_tensor * mm = cgraph->nodes[i + 2];
+    if (sc->op != GGML_OP_SCALE || si->op != GGML_OP_UNARY || ggml_get_unary_op(si) != GGML_UNARY_OP_SILU || si->src[0] != sc ||
+            mm->op != GGML_OP_MUL_MAT || mm->src[1] != si || !ggml_can_fuse(cgraph, i, {GGML_OP_SCALE, GGML_OP_UNARY})) {
+        return 0;
+    }
+    int j = i + 3;
+    while (j < cgraph->n_nodes && j <= i + 8 && ggml_cuda_is_view_or_noop(cgraph->nodes[j])) {
+        j++;
+    }
+    if (j >= cgraph->n_nodes || cgraph->nodes[j]->op != GGML_OP_DSV4_HC_PRE) {
+        return 0;
+    }
+    ggml_tensor * pre = cgraph->nodes[j];
+    const ggml_tensor * x  = pre->src[0];
+    const ggml_tensor * gw = pre->src[1];
+    const ggml_tensor * xs = sc->src[0];
+    const ggml_tensor * w  = mm->src[0];
+    const int64_t n_embd = x->ne[0];
+    const int64_t T      = mm->ne[1];  // tokens
+    if (gw == nullptr || gw->data != mm->data || ggml_get_op_params_i32(pre, 1) == 0 || pre->type != GGML_TYPE_F32 ||
+            T < 1 || T > max_tokens || mm->ne[2] != 1 || mm->ne[3] != 1 ||
+            !ggml_is_contiguous(pre) || x->type != GGML_TYPE_F32 || x->ne[1] != 4 || x->ne[2] != T || x->ne[3] != 1 ||
+            n_embd % 32 != 0 || pre->ne[0] != n_embd || pre->ne[1] != T || ggml_nelements(pre) != n_embd*T ||
+            gw->ne[0] != n_embd || gw->ne[1] != 4 || gw->ne[2] != T || gw->nb[2] != mm->nb[1] ||
+            w->type != GGML_TYPE_Q8_0 || w->nb[0] != ggml_type_size(w->type) || w->ne[0] != si->ne[0] || si->ne[0] % QK8_1 != 0 ||
+            si->ne[0] > 512 || mm->ne[0] != 4*n_embd || mm->type != GGML_TYPE_F32 || !ggml_is_contiguous(mm) ||
+            si->ne[1] != T || !ggml_is_contiguous(si) || si->type != GGML_TYPE_F32 || xs->type != GGML_TYPE_F32 ||
+            xs->ne[1] != T || xs->nb[0] != sizeof(float) || sc->type != GGML_TYPE_F32) {
+        return 0;
+    }
+    // every block reads the whole silu input, and each its rows of x, while the blocks write silu, the gate and hc_pre
+    for (const ggml_tensor * out : { (const ggml_tensor *) si, (const ggml_tensor *) mm, (const ggml_tensor *) pre }) {
+        if (ggml_cuda_tensors_overlap(out, xs) || ggml_cuda_tensors_overlap(out, x)) {
+            return 0;
+        }
+    }
+    return j;
+}
+
+static int ggml_cuda_try_hc_up_pre(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool off = getenv("GGML_CUDA_NO_HC_UP_PRE") != nullptr;
+    static const int64_t max_tokens = getenv("GGML_CUDA_HC_UP_PRE_NTOK") ? std::min<int64_t>(4, std::max(1, atoi(getenv("GGML_CUDA_HC_UP_PRE_NTOK")))) : 1;
+    const int j = off ? 0 : ggml_cuda_hc_up_pre_match(cgraph, i, max_tokens);
+    if (j == 0) {
+        return 0;
+    }
+    const ggml_tensor * sc = cgraph->nodes[i];
+    const ggml_tensor * si = cgraph->nodes[i + 1];
+    const ggml_tensor * mm = cgraph->nodes[i + 2];
+    ggml_tensor * pre = cgraph->nodes[j];
+    const int64_t n_embd = pre->src[0]->ne[0];
+    const int64_t T      = mm->ne[1];
+    void * q8 = ggml_cuda_hc_pre_q8_slot(ctx, cgraph, j);
+    if (!ggml_cuda_op_hc_up_pre(ctx, sc, si, mm, pre, q8)) {
+        return 0;
+    }
+
+    static const bool verify = getenv("GGML_CUDA_HC_UP_PRE_VERIFY") != nullptr;
+    if (verify) {
+        std::vector<float> p0(ggml_nelements(pre)), g0(ggml_nelements(mm)), p1(p0.size()), g1(g0.size());
+        CUDA_CHECK(cudaMemcpyAsync(p0.data(), pre->data, ggml_nbytes(pre), cudaMemcpyDeviceToHost, ctx.stream()));
+        CUDA_CHECK(cudaMemcpyAsync(g0.data(), mm->data, ggml_nbytes(mm), cudaMemcpyDeviceToHost, ctx.stream()));
+        for (int k = i; k <= j; k++) {
+            if (!ggml_cuda_is_view_or_noop(cgraph->nodes[k])) {
+                ggml_cuda_compute_forward(ctx, cgraph->nodes[k]);
+            }
+        }
+        CUDA_CHECK(cudaMemcpyAsync(p1.data(), pre->data, ggml_nbytes(pre), cudaMemcpyDeviceToHost, ctx.stream()));
+        CUDA_CHECK(cudaMemcpyAsync(g1.data(), mm->data, ggml_nbytes(mm), cudaMemcpyDeviceToHost, ctx.stream()));
+        CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+        const bool bad = memcmp(p0.data(), p1.data(), p0.size()*sizeof(float)) != 0 || memcmp(g0.data(), g1.data(), g0.size()*sizeof(float)) != 0;
+        static int nprint[5] = {};  // per token count
+        if (bad || nprint[T] < 8) {
+            nprint[T]++;
+            fprintf(stderr, "hc up pre verify: %s tokens %lld: %s\n", pre->name, (long long) T, bad ? "DIFFER" : "same");
+        }
+        if (q8 != nullptr) {
+            // the q8_1 copy: the ordinary hc_pre writes it again from the ordinary values
+            const size_t nq = (size_t) T*(n_embd/QK8_1)*sizeof(block_q8_1);
+            std::vector<char> q0(nq), q1(nq);
+            CUDA_CHECK(cudaMemcpyAsync(q0.data(), q8, nq, cudaMemcpyDeviceToHost, ctx.stream()));
+            ggml_cuda_op_dsv4_hc_pre(ctx, pre, q8);
+            CUDA_CHECK(cudaMemcpyAsync(q1.data(), q8, nq, cudaMemcpyDeviceToHost, ctx.stream()));
+            CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+            if (memcmp(q0.data(), q1.data(), nq) != 0) {
+                fprintf(stderr, "hc up pre verify: %s tokens %lld: q8_1 DIFFER\n", pre->name, (long long) T);
+            }
+        }
+    }
+    return j - i;
+}
+
+// engine2n: the cached q8_1 copy of src1 as mul_mat_vec_q would find it (ggml_cuda_mul_mat_vec_q), or nullptr
+static const void * ggml_cuda_q8_1_cache_find(ggml_backend_cuda_context & ctx, const ggml_tensor * src1) {
+    auto & qc = ctx.q8_1_cache;
+    const int64_t ne10_padded = GGML_PAD(src1->ne[0], MATRIX_ROW_PADDING);
+    const size_t  bytes = src1->ne[3]*src1->ne[2]*src1->ne[1]*ne10_padded*sizeof(block_q8_1)/QK8_1;
+    for (int k = 0; qc.live && k < qc.n_slots; k++) {
+        const auto & e = qc.slots[k];
+        if (e.used && e.lo == (const char *) src1->data && e.bytes == bytes &&
+                memcmp(e.ne, src1->ne, sizeof(e.ne)) == 0 && memcmp(e.nb, src1->nb, sizeof(e.nb)) == 0) {
+            qc.n_hit++;
+            return (const char *) qc.buf + k*qc.slot_size;
+        }
+    }
+    return nullptr;
+}
+
+// engine2n: GGML_CUDA_SEG_MOE=1 — the MoE segment's head, MUL_MAT(hc down, Q6_K, one token, over the hc norm's cached q8_1)
+// [-> views] -> the hc block (ggml_cuda_hc_up_pre_match) [-> views] -> MUL_MAT(router, BF16), as one persistent kernel
+// (dsv4-hc.cu k_seg_moe_head, same values; docs/DESIGN_megakernel.md step 1). Returns the nodes it covers past i, or 0.
+// GGML_CUDA_SEG_VERIFY=1 (debug) also runs the ordinary nodes and compares bit for bit.
+static int ggml_cuda_try_seg_moe_head(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    static const bool on = [] { const char * e = getenv("GGML_CUDA_SEG_MOE"); return e && atoi(e) != 0; }();
+    if (!on || !ctx.q8_1_cache.live) {
+        return 0;
+    }
+    ggml_tensor * dn = cgraph->nodes[i];
+    const ggml_tensor * wd = dn->src[0];
+    const ggml_tensor * y  = dn->src[1];
+    if (dn->op != GGML_OP_MUL_MAT || wd->type != GGML_TYPE_Q6_K || wd->ne[0] % QK_K != 0 || wd->nb[0] != ggml_type_size(wd->type) ||
+            wd->ne[2] != 1 || wd->ne[3] != 1 || y->type != GGML_TYPE_F32 || y->ne[0] != wd->ne[0] || y->ne[1] != 1 || y->ne[2] != 1 ||
+            y->ne[3] != 1 || !ggml_is_contiguous(y) || dn->type != GGML_TYPE_F32 || !ggml_is_contiguous(dn) || dn->ne[1] != 1) {
+        return 0;
+    }
+    int s = i + 1;
+    while (s < cgraph->n_nodes && ggml_cuda_is_view_or_noop(cgraph->nodes[s])) {
+        s++;
+    }
+    if (s >= cgraph->n_nodes || cgraph->nodes[s]->op != GGML_OP_SCALE) {
+        return 0;
+    }
+    const int j = ggml_cuda_hc_up_pre_match(cgraph, s, 1);
+    if (j == 0) {
+        return 0;
+    }
+    int r = j + 1;
+    while (r < cgraph->n_nodes && ggml_cuda_is_view_or_noop(cgraph->nodes[r])) {
+        r++;
+    }
+    if (r >= cgraph->n_nodes) {
+        return 0;
+    }
+    const ggml_tensor * sc  = cgraph->nodes[s];
+    const ggml_tensor * si  = cgraph->nodes[s + 1];
+    const ggml_tensor * mm  = cgraph->nodes[s + 2];
+    ggml_tensor *       pre = cgraph->nodes[j];
+    const ggml_tensor * rt  = cgraph->nodes[r];
+    const ggml_tensor * wr  = rt->src[0];
+    if (rt->op != GGML_OP_MUL_MAT || wr->type != GGML_TYPE_BF16 || rt->src[1] != pre || wr->nb[0] != sizeof(nv_bfloat16) ||
+            wr->ne[0] != pre->ne[0] || wr->ne[0] % 2 != 0 || wr->ne[2] != 1 || wr->ne[3] != 1 || rt->type != GGML_TYPE_F32 ||
+            !ggml_is_contiguous(rt) || rt->ne[1] != 1 || !ggml_is_contiguous(pre) || pre->ne[1] != 1 ||
+            // the router reads hc_pre in every block while blocks write its result; the hc down result feeds the hc block
+            ggml_cuda_tensors_overlap(rt, pre) || ggml_cuda_tensors_overlap(dn, pre->src[0]) || ggml_cuda_tensors_overlap(dn, y)) {
+        return 0;
+    }
+    const void * y_dn = ggml_cuda_q8_1_cache_find(ctx, y);
+    if (y_dn == nullptr) {
+        return 0;
+    }
+    void * q8 = ggml_cuda_hc_pre_q8_slot(ctx, cgraph, j);
+    if (q8 == y_dn) {
+        ctx.q8_1_cache.pending = -1;
+        return 0;
+    }
+    // verify: the group's outputs may sit where its input was (the router result over the hc norm, dead after hc_pre), so the
+    // ordinary rerun starts from a saved copy of the hc norm
+    static const bool verify = getenv("GGML_CUDA_SEG_VERIFY") != nullptr;
+    ggml_cuda_pool_alloc<char> y_saved(ctx.pool());
+    if (verify) {
+        y_saved.alloc(ggml_nbytes(y));
+        CUDA_CHECK(cudaMemcpyAsync(y_saved.get(), y->data, ggml_nbytes(y), cudaMemcpyDeviceToDevice, ctx.stream()));
+    }
+    if (!ggml_cuda_seg_moe_head(ctx, dn, y_dn, sc, si, mm, pre, q8, rt)) {
+        return 0;
+    }
+
+    if (verify) {
+        const ggml_tensor * outs[4] = { dn, mm, pre, rt };
+        std::vector<float> got[4], ref[4];
+        for (int k = 0; k < 4; k++) {
+            got[k].resize(ggml_nelements(outs[k]));
+            ref[k].resize(ggml_nelements(outs[k]));
+            CUDA_CHECK(cudaMemcpyAsync(got[k].data(), outs[k]->data, ggml_nbytes(outs[k]), cudaMemcpyDeviceToHost, ctx.stream()));
+        }
+        const size_t nq = q8 ? (size_t) (pre->ne[0]/QK8_1)*sizeof(block_q8_1) : 0;
+        std::vector<char> q0(nq), q1(nq);
+        if (q8) {
+            CUDA_CHECK(cudaMemcpyAsync(q0.data(), q8, nq, cudaMemcpyDeviceToHost, ctx.stream()));
+        }
+        CUDA_CHECK(cudaMemcpyAsync(y->data, y_saved.get(), ggml_nbytes(y), cudaMemcpyDeviceToDevice, ctx.stream()));
+        for (int k = i; k <= r; k++) {
