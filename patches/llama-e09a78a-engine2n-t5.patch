+static void ggml_cuda_q8_1_cache_note_write(ggml_backend_cuda_context & ctx, const ggml_tensor * t) {
+    if (t->data == nullptr) {
+        return;
+    }
+    ggml_cuda_q8_1_cache_note_range(ctx, (const char *) t->data, (const char *) t->data + ggml_nbytes(t));
