+// memory and adds the peer's partial. Flags are compared unsigned (>=), so writing 0xFFFFFFFF releases a waiter.
+static void * ggml_backend_cuda_comm_host_alloc(size_t size) {
+#if defined(GGML_USE_HIP)
+    void * ptr = nullptr;
+    if (hipHostMalloc(&ptr, size, hipHostMallocCoherent | hipHostMallocMapped | hipHostMallocPortable) != hipSuccess) {
+        return nullptr;
+    }
+    memset(ptr, 0, size);
+    return ptr;
+#else
+    GGML_UNUSED(size);
+    return nullptr;
+#endif
+}
