+static uint64_t * ggml_cuda_comm_ts_slot(uint32_t seq) {
+    uint64_t * ts = ggml_cuda_comm_ts();
+    return ts != nullptr ? ts + (seq % GGML_CUDA_COMM_TS_N)*8 : nullptr;
