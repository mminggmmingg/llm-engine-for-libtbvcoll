+
+// qwen4exp hyper-connection mix for 1..4 tokens (decode, MTP verify), fused from the graph nodes
+//   MUL_MAT(down_inject, xn) -> VIEW -> SCALE -> SILU -> MUL_MAT(up, .) -> RESHAPE -> DSV4_HC_PRE(xn, ., gated)
+// in two kernels (plus one that rounds the activations as q8_1, unless GGML_CUDA_HC_MIX=f32). Off unless GGML_CUDA_HC_MIX is set.
+// Writes the raw down_inject product (its inject rows feed the later hc_post) and the hc_pre result;
+// the up product is used as scratch.
+bool ggml_cuda_hc_mix_match(const ggml_cgraph * cgraph, int node_idx);
+void ggml_cuda_op_hc_mix(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int node_idx);
