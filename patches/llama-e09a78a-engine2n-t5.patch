+bool ggml_cuda_mmvq_warp_row_supported(ggml_type type, int cc) {
+    // the per-warp loop above is the ordinary kernel's only on the RDNA2 table (nwarps 1, rows_per_block 1, no small_k)
+    if (get_device_table_id(cc) != MMVQ_PARAMETERS_RDNA2) {
+        return false;
+    }
+    switch (type) {
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q5_0:
+        case GGML_TYPE_Q8_0:
+        case GGML_TYPE_IQ4_NL:
+        case GGML_TYPE_IQ4_XS:
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_Q6_K:
+            return true;
+        default:
+            return false;
+    }
+}
