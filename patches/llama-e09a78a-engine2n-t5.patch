+// engine2n: GGML_CUDA_MMVQ_SPLITK=<S> — a one-column matmul with few rows (hc down: 324 rows of 10240) leaves most of the GPU
+// idle with one warp per row. Here S warps share a row: warp w takes the K iterations w, w+S, ... of the usual loop, sums them
+// per lane and over the warp, and warp 0 adds the S partial sums in order 0..S-1. Deterministic (no atomics), but the order of
+// the additions differs from mul_mat_vec_q, so the last bits of the result differ (GGML_CUDA_MMVQ_SPLITK_VERIFY measures by how much).
+template <ggml_type type, int S>
+static __global__ void __launch_bounds__(32*S, 1) mul_mat_vec_q_splitk(
+        const void * __restrict__ vx, const void * __restrict__ vy, float * __restrict__ dst, const uint32_t ncols_x,
+        const uint32_t stride_row_x) {
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr int blocks_per_iter = vdr*32/qi;
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+    __shared__ float part[S];
+
+    const int lane = threadIdx.x;
+    const int w    = threadIdx.y;
+    const int row  = blockIdx.x;
+    const int blocks_per_row_x = ncols_x / qk;
+    const block_q8_1 * y = (const block_q8_1 *) vy;
+    const int kbx_offset = row*stride_row_x;
+
+    float tmp = 0.0f;
+    for (int kbx = lane / (qi/vdr) + w*blocks_per_iter; kbx < blocks_per_row_x; kbx += S*blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const int kqs = vdr * (lane % (qi/vdr));
+        tmp += vec_dot_q_cuda(vx, &y[kby], kbx_offset + kbx, kqs);
+    }
+    tmp = warp_reduce_sum<32>(tmp);
+    if (lane == 0) {
+        part[w] = tmp;
+    }
+    __syncthreads();
+    if (w == 0 && lane == 0) {
+        float sum = part[0];
+#pragma unroll
+        for (int k = 1; k < S; k++) {
+            sum += part[k];
+        }
+        dst[row] = sum;
+    }
+}
+
+template <ggml_type type>
+static bool mul_mat_vec_q_splitk_launch(const void * vx, const void * vy, float * dst, const int ncols_x, const int nrows_x,
+        const int stride_row_x, const int S, cudaStream_t stream) {
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    if (ncols_x / qk < S * (vdr*32/qi)) {
+        return false;  // a warp would get no iteration
+    }
+    switch (S) {
+        case 2: mul_mat_vec_q_splitk<type, 2><<<nrows_x, dim3(32, 2), 0, stream>>>(vx, vy, dst, ncols_x, stride_row_x); break;
+        case 4: mul_mat_vec_q_splitk<type, 4><<<nrows_x, dim3(32, 4), 0, stream>>>(vx, vy, dst, ncols_x, stride_row_x); break;
+        case 8: mul_mat_vec_q_splitk<type, 8><<<nrows_x, dim3(32, 8), 0, stream>>>(vx, vy, dst, ncols_x, stride_row_x); break;
+        default: return false;
+    }
+    return true;
+}
+
+static bool mul_mat_vec_q_splitk_switch_type(const void * vx, const ggml_type type_x, const void * vy, float * dst, const int ncols_x,
+        const int nrows_x, const int stride_row_x, const int S, cudaStream_t stream) {
+    switch (type_x) {
+        case GGML_TYPE_Q5_0:   return mul_mat_vec_q_splitk_launch<GGML_TYPE_Q5_0>  (vx, vy, dst, ncols_x, nrows_x, stride_row_x, S, stream);
+        case GGML_TYPE_Q8_0:   return mul_mat_vec_q_splitk_launch<GGML_TYPE_Q8_0>  (vx, vy, dst, ncols_x, nrows_x, stride_row_x, S, stream);
+        case GGML_TYPE_Q6_K:   return mul_mat_vec_q_splitk_launch<GGML_TYPE_Q6_K>  (vx, vy, dst, ncols_x, nrows_x, stride_row_x, S, stream);
+        case GGML_TYPE_IQ4_XS: return mul_mat_vec_q_splitk_launch<GGML_TYPE_IQ4_XS>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, S, stream);
+        case GGML_TYPE_IQ4_NL: return mul_mat_vec_q_splitk_launch<GGML_TYPE_IQ4_NL>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, S, stream);
+        default:               return false;
+    }
+}
+
+// GGML_CUDA_MMVQ_SPLITK_VERIFY=1: per weight (layer number dropped) how far the split result is from mul_mat_vec_q's
+struct mmvq_splitk_stats {
+    uint64_t calls = 0, elems = 0, ndiff = 0;
+    double   max_abs = 0, max_rel = 0, sum_d2 = 0, sum_r2 = 0;
+};
+static void mmvq_splitk_note(const char * wname, const float * got, const float * ref, const int64_t n) {
+    static std::map<std::string, mmvq_splitk_stats> stats;
+    static uint64_t ncalls = 0;
+    std::string key(wname);
+    for (size_t p = key.find("blk."); p != std::string::npos && p + 4 < key.size(); p = std::string::npos) {
+        size_t q = p + 4;
+        while (q < key.size() && isdigit((unsigned char) key[q])) {
+            q++;
+        }
+        key = key.substr(0, p + 4) + "*" + key.substr(q);
+    }
+    mmvq_splitk_stats & st = stats[key];
+    double amax = 0;
+    for (int64_t e = 0; e < n; e++) {
+        amax = std::max(amax, (double) fabsf(ref[e]));
+    }
+    for (int64_t e = 0; e < n; e++) {
+        const double d = fabs((double) got[e] - (double) ref[e]);
+        st.ndiff  += memcmp(&got[e], &ref[e], sizeof(float)) != 0;
+        st.max_abs = std::max(st.max_abs, d);
+        if (fabsf(ref[e]) > 1e-3*amax) {
+            st.max_rel = std::max(st.max_rel, d / fabs((double) ref[e]));
+        }
+        st.sum_d2 += d*d;
+        st.sum_r2 += (double) ref[e]*ref[e];
+    }
+    st.calls++;
+    st.elems += n;
+    if (++ncalls % 2000 == 0) {
+        for (const auto & [k, v] : stats) {
+            fprintf(stderr, "mmvq splitk verify: %-40s calls %8llu elems %10llu differ %6.2f%% max abs %.3g max rel %.3g rms rel %.3g\n",
+                k.c_str(), (unsigned long long) v.calls, (unsigned long long) v.elems, 100.0*v.ndiff/std::max<uint64_t>(v.elems, 1),
+                v.max_abs, v.max_rel, sqrt(v.sum_d2/std::max(v.sum_r2, 1e-30)));
+        }
+    }
+}
+
+// engine2n: one-token GLU matmul (gate and up, SWIGLU) whose result is also needed as q8_1 by the next quantized matmul (the
+// down projection). A block of 32 warps owns 32 consecutive rows of one channel: each warp computes its row with the loop, warp
+// sum and GLU epilogue mul_mat_vec_q uses on RDNA (one warp per row, nwarps 1, rows_per_block 1), and warp 0 writes the q8_1
+// block of the 32 results with quantize_q8_1's code. Same values; the down matmul's quantize kernel goes away. Block 0 of each
+// channel also zeroes the row padding blocks, as quantize_q8_1 writes them.
+template <ggml_type type>
+static __global__ void __launch_bounds__(1024, 1) mul_mat_vec_q_glu_q8(
+        const void * vx, const void * vgate, const void * vy, const int32_t * ids, float * dst, block_q8_1 * q8,
+        const uint32_t ncols_x, const uint32_t nrows_x, const uint32_t nchannels_y, const uint32_t stride_row_x,
+        const uint32_t stride_channel_x, const uint32_t stride_channel_y, const uint32_t stride_channel_dst,
+        const uint32_t q8_blocks_per_channel) {
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr int warp_size = 32;
+    constexpr int blocks_per_iter = vdr * warp_size / qi;
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+    __shared__ float vo[warp_size];
+
+    const int lane = threadIdx.x % warp_size;
+    const int warp = threadIdx.x / warp_size;
+    const uint32_t channel_dst = blockIdx.y;
+    const uint32_t channel_x   = ids ? ids[channel_dst] : channel_dst;
+    const uint32_t channel_y   = ids ? channel_dst % nchannels_y : channel_dst;
+    const int row0 = blockIdx.x*warp_size + warp;
+    const int blocks_per_row_x = ncols_x / qk;
+
+    float tmp      = 0.0f;
+    float tmp_gate = 0.0f;
+    const block_q8_1 * y = ((const block_q8_1 *) vy) + channel_y*stride_channel_y;
+    const int kbx_offset = channel_x*stride_channel_x + row0*stride_row_x;
+    for (int kbx = lane / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const int kqs = vdr * (lane % (qi/vdr));
+        tmp      += vec_dot_q_cuda(vx,    &y[kby], kbx_offset + kbx, kqs);
+        tmp_gate += vec_dot_q_cuda(vgate, &y[kby], kbx_offset + kbx, kqs);
+    }
+    tmp      = warp_reduce_sum<warp_size>(tmp);
+    tmp_gate = warp_reduce_sum<warp_size>(tmp_gate);
+
+    if (lane == 0) {
+        float result = tmp;
+        result += 0.0f;  // the bias add of the fused epilogue (no bias)
+        float gate_value = tmp_gate;
+        gate_value += 0.0f;
+        result *= ggml_cuda_op_silu_single(gate_value);
+        dst[channel_dst*stride_channel_dst + row0] = result;
+        vo[warp] = result;
+    }
+    __syncthreads();
+
+    block_q8_1 * q = q8 + (size_t) channel_dst*q8_blocks_per_channel;
+    if (warp == 0) {
+        const float w = vo[lane];
+        float amax = fabsf(w);
+        float vsum = w;
+        amax = warp_reduce_max<QK8_1>(amax);
+        vsum = warp_reduce_sum<QK8_1>(vsum);
+        const float  d = amax / 127.0f;
+        const int8_t qv = amax == 0.0f ? 0 : roundf(w / d);
+        q[blockIdx.x].qs[lane] = qv;
+        if (lane == 0) {
+            q[blockIdx.x].ds = make_half2(d, vsum);
+        }
+    } else if (blockIdx.x == 0) {
+        const int used = nrows_x / QK8_1;
+        int * pad = (int *) (q + used);
+        const int n = (q8_blocks_per_channel - used) * (int) (sizeof(block_q8_1) / sizeof(int));
+        for (int k = threadIdx.x - warp_size; k < n; k += blockDim.x - warp_size) {
+            pad[k] = 0;
+        }
+    }
+}
+
+template <ggml_type type>
+static void mul_mat_vec_q_glu_q8_launch(
+        const void * vx, const void * vgate, const void * vy, const int32_t * ids, float * dst, void * q8,
+        const int ncols_x, const int nrows_x, const int nchannels_y, const int nchannels_dst, const int stride_row_x,
+        const int stride_channel_x, const int stride_channel_y, const int stride_channel_dst, const int q8_blocks_per_channel,
+        cudaStream_t stream) {
+    const dim3 grid(nrows_x / 32, nchannels_dst, 1);
+    mul_mat_vec_q_glu_q8<type><<<grid, 1024, 0, stream>>>(vx, vgate, vy, ids, dst, (block_q8_1 *) q8, ncols_x, nrows_x,
+        nchannels_y, stride_row_x, stride_channel_x, stride_channel_y, stride_channel_dst, q8_blocks_per_channel);
+}
+
+// engine2n: shared expert down projection of T <= 4 tokens followed by the gate tail k_shexp_gate_dot_tail fuses (gate dot,
+// SIGMOID, MUL, ADD of the routed output). Warp w computes row blockIdx.x*32 + w of every token with the loop and warp sum
+// mul_mat_vec_q uses on RDNA (one warp per row whatever the number of columns, one sum per column), the first 256 threads make
+// each token's gate dot as k_shexp_gate_dot_tail does, and lane 0 writes moe + row*sigmoid(g) rounded as there. Same values;
+// one kernel instead of two.
+template <ggml_type type, int T>
+static __global__ void __launch_bounds__(1024, 1) mul_mat_vec_q_shexp_tail(
+        const void * vx, const void * vy, const int stride_col_y, const float * gw, const float * gy, const int64_t sgy1, const int ncols2,
+        const float * moe, const int64_t sm1, float * dst, const int64_t sd1, const uint32_t ncols_x, const uint32_t stride_row_x,
+        const ggml_cuda_comm_fused comm) {
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr int warp_size = 32;
+    constexpr int blocks_per_iter = vdr * warp_size / qi;
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+    __shared__ float buf[WARP_SIZE];
+
+    float g[T];
+#pragma unroll
+    for (int t = 0; t < T; ++t) {
+        g[t] = shexp_gate_dot_256<1024>(gw, gy + t*sgy1, ncols2, buf);
+        if (t + 1 < T) {
+            __syncthreads();  // every thread has read buf[0] before the next token's dot clears it
+        }
+    }
+
+    const int lane = threadIdx.x % warp_size;
+    const int row0 = blockIdx.x*warp_size + threadIdx.x / warp_size;
+    const int blocks_per_row_x = ncols_x / qk;
+    float tmp[T] = { 0.0f };
+    const block_q8_1 * y = (const block_q8_1 *) vy;
+    const int kbx_offset = row0*stride_row_x;
+    for (int kbx = lane / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const int kqs = vdr * (lane % (qi/vdr));
+#pragma unroll
+        for (int t = 0; t < T; ++t) {
+            tmp[t] += vec_dot_q_cuda(vx, &y[t*stride_col_y + kby], kbx_offset + kbx, kqs);
+        }
+    }
+#pragma unroll
+    for (int t = 0; t < T; ++t) {
+        tmp[t] = warp_reduce_sum<warp_size>(tmp[t]);
+    }
+    if (comm.flag != nullptr) {
+        ggml_cuda_comm_fused_wait_add(comm);  // the routed output's allreduce, behind this kernel's own matmul
+    }
+    if (lane == 0) {
+#pragma unroll
+        for (int t = 0; t < T; ++t) {
+#pragma clang fp contract(off)
+            const float sig = ggml_cuda_op_sigmoid_single(g[t]);
+            const float m   = tmp[t] * sig;
+            dst[t*sd1 + row0] = moe[t*sm1 + row0] + m;
+        }
+    }
+}
+
+template <ggml_type type>
+static void mul_mat_vec_q_shexp_tail_cols(
+        const void * vx, const void * vy, const int ncols_y, const int stride_col_y, const float * gw, const float * gy, const int64_t sgy1,
+        const int ncols2, const float * moe, const int64_t sm1, float * dst, const int64_t sd1, const int ncols_x, const int nrows_x,
+        const int stride_row_x, const ggml_cuda_comm_fused & comm, cudaStream_t stream) {
+#define SHEXP_TAIL_COLS(T) case T: mul_mat_vec_q_shexp_tail<type, T><<<nrows_x / 32, 1024, 0, stream>>>(vx, vy, stride_col_y, gw, gy, sgy1, \
+        ncols2, moe, sm1, dst, sd1, ncols_x, stride_row_x, comm); break;
+    switch (ncols_y) {
+        SHEXP_TAIL_COLS(1)
+        SHEXP_TAIL_COLS(2)
+        SHEXP_TAIL_COLS(3)
+        SHEXP_TAIL_COLS(4)
+        default:
+            GGML_ABORT("shexp tail: more than 4 tokens");
+    }
+#undef SHEXP_TAIL_COLS
+}
+
+static void mul_mat_vec_q_shexp_tail_switch_type(
+        const void * vx, const ggml_type type_x, const void * vy, const int ncols_y, const int stride_col_y, const float * gw, const float * gy,
+        const int64_t sgy1, const int ncols2, const float * moe, const int64_t sm1, float * dst, const int64_t sd1, const int ncols_x,
+        const int nrows_x, const int stride_row_x, const ggml_cuda_comm_fused & comm, cudaStream_t stream) {
+#define SHEXP_TAIL_CASE(t) case t: mul_mat_vec_q_shexp_tail_cols<t>(vx, vy, ncols_y, stride_col_y, gw, gy, sgy1, ncols2, moe, sm1, dst, sd1, \
+        ncols_x, nrows_x, stride_row_x, comm, stream); break;
+    switch (type_x) {
+        SHEXP_TAIL_CASE(GGML_TYPE_Q4_0)
+        SHEXP_TAIL_CASE(GGML_TYPE_Q5_0)
+        SHEXP_TAIL_CASE(GGML_TYPE_Q8_0)
+        SHEXP_TAIL_CASE(GGML_TYPE_IQ4_NL)
+        SHEXP_TAIL_CASE(GGML_TYPE_IQ4_XS)
+        SHEXP_TAIL_CASE(GGML_TYPE_Q4_K)
+        SHEXP_TAIL_CASE(GGML_TYPE_Q5_K)
+        SHEXP_TAIL_CASE(GGML_TYPE_Q6_K)
