+// exchange is DPP row_xmask (offsets 1..8) or v_permlanex16 (offset 16) instead of ds_bpermute: the same lanes, so the same
+// values, without the round trip through LDS (topk_moe 16.7k -> 8.7k cycles). GGML_CUDA_NO_XOR_DPP at build time turns it off.
+static __device__ __forceinline__ int ggml_cuda_shfl_xor(const int x, const int offset, const int width = WARP_SIZE) {
+#if defined(GGML_USE_HIP) && defined(RDNA) && !defined(GGML_CUDA_NO_XOR_DPP)
+    GGML_UNUSED(width);
+    switch (offset) {
+        case 16: return __builtin_amdgcn_permlanex16(x, x, 0x76543210, 0xfedcba98, false, false);
+        case 8:  return __builtin_amdgcn_update_dpp(x, x, 0x168, 0xf, 0xf, false);
+        case 4:  return __builtin_amdgcn_update_dpp(x, x, 0x164, 0xf, 0xf, false);
+        case 2:  return __builtin_amdgcn_update_dpp(x, x, 0x162, 0xf, 0xf, false);
+        case 1:  return __builtin_amdgcn_update_dpp(x, x, 0x161, 0xf, 0xf, false);
